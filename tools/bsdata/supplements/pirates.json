  "reglesTexte": {
    "Swabbies": {
      "fr": {
        "nom": "Moussaillons",
        "resume": "Les pirates ne recrutent pas de moussaillons contre de l'or : ils enrôlent de force des humains capturés (héros ou hommes de main ennemis vaincus, traînards ou prisonniers trouvés en exploration). Il ne peut jamais y avoir plus de moussaillons que de matelots ; ni francs-tireurs ni personnages spéciaux ne peuvent être enrôlés."
      },
      "en": {
        "nom": "Swabbies",
        "resume": "Swabbies are not bought: captured humans (defeated enemy Heroes or Henchmen, stragglers or prisoners found when exploring) are pressed into the crew. There may never be more Swabbies than Crew; Hired Swords and special characters can never be pressed."
      }
    },
    "Kidnapped!": {
      "fr": {
        "nom": "Enlevé !",
        "resume": "Un héros humain ennemi capturé peut se voir proposer de rejoindre l'équipage : on fait un duel de Commandement sur 2D6 (le pirate ajoute le Cd du capitaine) ; s'il perd, il devient un moussaillon et son équipement est confisqué."
      },
      "en": {
        "nom": "Kidnapped!",
        "resume": "A captured enemy human Hero may be pressed into the crew through a 2D6 Leadership contest (the Pirate adds the Captain's Ld); if he loses he becomes a Swabbie and his gear is taken."
      }
    },
    "Succession": {
      "fr": {
        "nom": "Succession",
        "resume": "Si le capitaine meurt, un second prend le commandement, comme le champion d'une bande de mercenaires."
      },
      "en": {
        "nom": "Succession",
        "resume": "If the Captain dies, a Ship's Mate takes command, as a Mercenary Champion would."
      }
    },
    "Swivel Guns is Dangerous, Matey!": {
      "fr": {
        "nom": "Le pierrier, c'est dangereux, matelot !",
        "resume": "Un canonnier armé du pierrier (un seul par bande, Rare 8) forme toujours un groupe à lui seul ; il doit être recruté à part ou être séparé d'un groupe existant en gardant expérience et compétences."
      },
      "en": {
        "nom": "Swivel Guns is Dangerous, Matey!",
        "resume": "A Gunner carrying the warband's single Swivel Gun (Rare 8) always forms a group of one; he is hired alone or split from his group, keeping his experience and skills."
      }
    },
    "Expert Riggers": {
      "fr": {
        "nom": "Gréeurs experts",
        "resume": "Les maîtres d'équipage commencent avec une corde et grappin qu'ils ne peuvent ni vendre ni céder, et relancent les tests d'Initiative ratés pour sauter un vide, sauter vers le bas, charger en plongeant ou grimper à la corde."
      },
      "en": {
        "nom": "Expert Riggers",
        "resume": "Boatswains start with a Rope & Hook they can never sell or give away, and re-roll failed Initiative tests to leap gaps, jump down, make diving charges or climb ropes."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Pirates)",
    "listeEn": "Special Skills (Pirates)",
    "competences": [
      {
        "en": "Sea Shanty Singer",
        "nom": "Chanteur de shanties",
        "resume": "Au début de la phase de corps à corps, il chante pour distraire un ennemi en contact : celui-ci doit réussir un test de Cd ou perdre 1 Attaque ce tour-ci (sans effet sur les morts-vivants et autres créatures non vivantes).",
        "resumeEn": "At the start of the close combat phase, he distracts one enemy in base contact, which must pass a Ld test or lose 1 Attack that turn (no effect on Undead and other non-living creatures).",
        "condition": null
      },
      {
        "en": "Sea Legs",
        "nom": "Pied marin",
        "resume": "Lors d'une chute, il peut ignorer les D3 touches sur 4+ ; près d'un bord, il relance le test d'Initiative pour ne pas tomber quand il est mis à terre ou sonné.",
        "resumeEn": "When falling he may ignore the D3 hits on a 4+; near an edge, he may re-roll the Initiative test to avoid falling when knocked down or stunned.",
        "condition": null
      },
      {
        "en": "Cutlass Master",
        "nom": "Maître du sabre",
        "resume": "Armé d'une épée, il pare sur un résultat égal (et non seulement supérieur) au jet pour toucher adverse, s'il est à couvert ou à 2 ps ou moins d'un décor.",
        "resumeEn": "With a sword he parries on a roll equal to (not only higher than) the enemy's to-hit roll, while in cover or within 2\" of terrain.",
        "condition": null
      },
      {
