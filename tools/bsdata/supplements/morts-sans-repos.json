  "reglesTexte": {
    "Wizard (Restless Dead Necromancy)": {
      "fr": {
        "nom": "Sorcier (Nécromancie des Morts sans repos)",
        "resume": "Lance des sorts de la liste de nécromancie propre aux Morts sans repos (différente de celle du livre de règles) ; la liche en connaît deux tirés au hasard."
      },
      "en": {
        "nom": "Wizard (Restless Dead Necromancy)",
        "resume": "Casts spells from the Restless Dead necromancy list (different from the core rules one); the Liche starts with two random spells."
      }
    },
    "Eternal": {
      "fr": {
        "nom": "Éternel",
        "resume": "Peut ignorer une blessure grave (sauf Mort) en perdant définitivement 1 PV ; un résultat Mort coûte D3 PV et la liche meurt si ses PV tombent à 0."
      },
      "en": {
        "nom": "Eternal",
        "resume": "May ignore a serious injury (except Dead) by permanently losing 1 Wound; a Dead result costs D3 Wounds and the Liche dies if it drops to 0."
      }
    },
    "Feed Upon Magic": {
      "fr": {
        "nom": "Se nourrir de magie",
        "resume": "Entre deux batailles, en consommant D3 trésors, la liche gagne définitivement +1 PV (pas si elle a cherché des objets rares ou a été mise hors de combat)."
      },
      "en": {
        "nom": "Feed Upon Magic",
        "resume": "Between battles, by consuming D3 treasures, the Liche permanently gains +1 Wound (not if it searched for rare items or was taken out of action)."
      }
    },
    "Warrior Wizard": {
      "fr": {
        "nom": "Sorcier guerrier",
        "resume": "Peut porter une armure et lancer des sorts."
      },
      "en": {
        "nom": "Warrior Wizard",
        "resume": "May wear armour and cast spells."
      }
    },
    "Liche Advancement": {
      "fr": {
        "nom": "Progression de la liche",
        "resume": "Une progression +1 PV peut être remplacée par une nouvelle compétence."
      },
      "en": {
        "nom": "Liche Advancement",
        "resume": "A +1 Wound advance may be exchanged for a new skill."
      }
    },
    "No Mundane Weapons": {
      "fr": {
        "nom": "Aucune arme ordinaire",
        "resume": "Ne peut porter aucune arme non magique, sans pénalité ; peut porter les armures de la liste."
      },
      "en": {
        "nom": "No Mundane Weapons",
        "resume": "May not carry non-magical weapons, without penalty; may wear armour from the list."
      }
    },
    "Apprentices": {
      "fr": {
        "nom": "Apprenti",
        "resume": "Commence avec l'un des sorts de la liche et ne peut connaître que des sorts qu'elle connaît, tant qu'elle vit."
      },
      "en": {
        "nom": "Apprentices",
        "resume": "Starts with one of the Liche's spells and may only know spells the Liche knows while it lives."
      }
    },
    "Gofer": {
      "fr": {
        "nom": "Homme à tout faire",
        "resume": "Pour chercher des objets rares, lance 3D6 et garde les deux meilleurs."
      },
      "en": {
        "nom": "Gofer",
        "resume": "When searching for rare items, rolls 3D6 and keeps the best two."
      }
    },
    "Wight Blades": {
      "fr": {
        "nom": "Lames des revenants",
        "resume": "Au corps à corps, un 6 pour toucher blesse automatiquement ; on jette quand même pour blesser afin de déterminer un critique."
      },
      "en": {
        "nom": "Wight Blades",
        "resume": "In close combat a to-hit roll of 6 wounds automatically; still roll to wound to check for a critical."
      }
    },
    "No Deal": {
      "fr": {
        "nom": "Pas d'affaires",
        "resume": "Ne peut pas chercher d'objets rares."
      },
      "en": {
        "nom": "No Deal",
        "resume": "May not search for rare items."
      }
    },
    "Wight Promotion": {
      "fr": {
        "nom": "Promotion du revenant",
        "resume": "Promu héros, il ne peut pas chercher d'objets rares, doit choisir Combat et Force et gagne Lames des revenants."
      },
      "en": {
        "nom": "Wight Promotion",
        "resume": "If promoted to Hero, it may not search for rare items, must choose Combat and Strength and gains Wight Blades."
      }
    },
    "No Substance": {
      "fr": {
        "nom": "Sans substance",
        "resume": "Compte comme E6 contre les tirs et projectiles magiques et ignore les critiques de tir."
      },
      "en": {
        "nom": "No Substance",
        "resume": "Counts as T6 against shooting and magic missiles and ignores shooting critical hits."
      }
    },
    "Highly Flammable": {
      "fr": {
        "nom": "Très inflammable",
        "resume": "Prend feu sur 3+ au lieu de 4+ et subit le double de dégâts des attaques enflammées."
      },
      "en": {
        "nom": "Highly Flammable",
        "resume": "Catches fire on 3+ instead of 4+ and takes double damage from fire attacks."
      }
    },
    "Construct": {
      "fr": {
        "nom": "Construction",
        "resume": "Peut relancer ses jets sur le tableau des blessures, sauf contre les blessures dues au feu."
      },
      "en": {
        "nom": "Construct",
        "resume": "May re-roll Injury table results, except for wounds caused by fire."
      }
    },
    "Animated Construct": {
      "fr": {
        "nom": "Construction animée",
        "resume": "Contrôlé par la liche ou le nécromancien (un chacun) ; absent si son maître l'est, et mis hors de combat si ce maître perd un PV et rate un test de Commandement."
      },
      "en": {
        "nom": "Animated Construct",
        "resume": "Controlled by the Liche or the Necromancer (one each); absent if its master is, and taken out of action if the master loses a Wound and fails a Leadership test."
      }
    }
  },
