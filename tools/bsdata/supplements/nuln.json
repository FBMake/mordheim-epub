  "reglesTexte": {
    "Impeccable Care": {
      "fr": {
        "nom": "Soin impeccable",
        "resume": "La bande achète toujours les armes à poudre noire de sa liste de départ à prix réduit, et gagne +2 aux jets de rareté pour trouver des armes à poudre noire."
      },
      "en": {
        "nom": "Impeccable Care",
        "resume": "The warband always buys the black powder weapons of its starting list at the reduced price and gets +2 on rarity rolls for black powder weapons."
      }
    },
    "Properly Used": {
      "fr": {
        "nom": "Bon usage",
        "resume": "Avec la règle optionnelle des enrayements, un résultat de 1 peut être relancé : sur 3+, l'arme n'explose pas (le tir rate quand même)."
      },
      "en": {
        "nom": "Properly Used",
        "resume": "With the optional misfire rules, a misfire roll of 1 may be re-rolled; on 3+ the weapon does not misfire (the shot still misses)."
      }
    },
    "Proud To A Fault!": {
      "fr": {
        "nom": "Fierté mal placée !",
        "resume": "Les membres de la bande n'utilisent jamais d'armes de tir autres qu'à poudre noire (les francs-tireurs et personnages spéciaux ne sont pas concernés)."
      },
      "en": {
        "nom": "Proud To A Fault!",
        "resume": "Warband members never use non-black-powder missile weapons; Hired Swords and Dramatis Personae are exempt."
      }
    },
    "Hunter": {
      "fr": {
        "nom": "Chasseur",
        "resume": "Possède la compétence de Tir « Chasseur » : peut tirer à chaque tour avec une arquebuse ou un long fusil d'Hochland (rechargement rapide)."
      },
      "en": {
        "nom": "Hunter",
        "resume": "Has the Shooting skill Hunter: may fire a handgun or Hochland long rifle every turn (quick reloading)."
      }
    },
    "Quick Reload": {
      "fr": {
        "nom": "Rechargement rapide",
        "resume": "Entraînés à recharger vite sous le feu, ces tireurs ont la compétence Chasseur ; promus héros, la reprendre n'apporte rien de plus."
      },
      "en": {
        "nom": "Quick Reload",
        "resume": "Drilled to reload quickly under pressure, these marksmen have the Hunter skill; if promoted, taking Hunter again gives no extra benefit."
      }
    },
    "Crack Shot": {
      "fr": {
        "nom": "Tireur hors pair",
        "resume": "Au premier round d'un corps à corps, peut relancer les jets pour toucher ratés avec un pistolet."
      },
      "en": {
        "nom": "Crack Shot",
        "resume": "In the first round of close combat may re-roll missed to-hit rolls made with a pistol."
      }
    }
  },
  "competencesSpeciales": null,
  "races": {},
  "notes": "Source Nemesis Crown. Leader de l'Officier : portée 12 ps (au lieu de 6). Expert Weaponsmith (Instructeur présent) : +3 ps de portée aux pistolets, +6 ps aux autres armes à poudre noire de la bande. Instructeur et Élèves de première année utilisent la « School's Armoury List », non définie sur la page : assimilée à la liste de l'École (Gunnery School) ; l'Instructeur a aussi accès à la liste des Tireurs d'élite (fusion des deux listes). Prix des paires (brace) donnés comme objets séparés. Mace/Hammer = une seule entrée à 3 co. Impeccable Care : la page ne chiffre pas la réduction (les prix de la liste sont déjà réduits). Hunter est une compétence de Tir du livre de règles, saisie ici comme règle du guerrier. Pas de liste de compétences spéciales."
}