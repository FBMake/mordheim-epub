 "reglesTexte": {
  "Death of the Leader": {
   "fr": {
    "nom": "Mort du chef",
    "resume": "Si le Nécrarque meurt, le Thrall prend la tête de la bande et tire un sort ; on ne peut pas recruter de nouveau Nécrarque, mais un Acolyte peut devenir Thrall. Si les deux disparaissent ensemble, la bande est dissoute."
   },
   "en": {
    "nom": "Death of the Leader",
    "resume": "If the Necrarch dies the Thrall takes over and rolls a spell; no new Necrarch may be hired but an Acolyte may become a Thrall. If both are lost together the warband disbands."
   }
  },
  "Wizard (Scrolls of Nagash)": {
   "fr": {
    "nom": "Sorcier (Parchemins de Nagash)",
    "resume": "Lanceur de sorts : commence avec un sort tiré au hasard sur les Parchemins de Nagash."
   },
   "en": {
    "nom": "Wizard (Scrolls of Nagash)",
    "resume": "Spellcaster: starts with one random spell from the Dreaded Scrolls of Nagash."
   }
  },
  "Vassal": {
   "fr": {
    "nom": "Vassal",
    "resume": "Si le Nécrarque voit l'Acolyte et que celui-ci n'est pas au corps à corps, il peut lancer ses sorts depuis la position de l'Acolyte ; sur un double 1, l'Acolyte fait un jet de blessure à +1."
   },
   "en": {
    "nom": "Vassal",
    "resume": "If the Necrarch can see the Acolyte and it is not in combat, he may cast spells from the Acolyte's position; on a double 1 the Acolyte rolls on the Injury table at +1."
   }
  },
  "Powered": {
   "fr": {
    "nom": "Animé par la malepierre",
    "resume": "Il faut un fragment de malepierre pour l'animer ; celui qui le met hors de combat récupère ce fragment, et un nouveau fragment est nécessaire pour le réanimer."
   },
   "en": {
    "nom": "Powered",
    "resume": "Needs a wyrdstone shard to animate; whoever takes it out of action gains the shard, and a new shard is needed to reanimate it."
   }
  },
  "Spare Parts": {
   "fr": {
    "nom": "Pièces de rechange",
    "resume": "Les résultats 1 et 2 au jet de blessure après la bataille sont ignorés : il ne peut pas être détruit."
   },
   "en": {
    "nom": "Spare Parts",
    "resume": "Post-battle Injury results of 1 and 2 are ignored, so it cannot be destroyed."
   }
  }
 },
 "competencesSpeciales": {
  "liste": "Spéciales (Nécrarques, voleurs d'âmes)",
  "listeEn": "Special Skills (Necrarchs)",
  "competences": [
   {
    "en": "Pupil of Nagash",
    "nom": "Disciple de Nagash",
    "resume": "Tire immédiatement un sort sur les Parchemins de Nagash ; peut reprendre cette compétence plus tard au lieu d'une autre.",
    "resumeEn": "Immediately roll a spell from the Scrolls of Nagash; may be taken again instead of a later skill.",
    "condition": null
   },
   {
    "en": "Master of the Black Arts",
    "nom": "Maître des arts noirs",
    "resume": "La portée de tous ses sorts est augmentée de moitié.",
    "resumeEn": "Increases the range of all his spells by half.",
    "condition": null
   },
   {
    "en": "Pull of Undeath",
    "nom": "Emprise de la non-mort",
    "resume": "Tant que le Nécrarque est à 4 ps ou moins d'un homme de main mort-vivant, il n'est mis hors de combat que sur un 6 naturel.",
    "resumeEn": "While within 4\" of an undead henchman he is only taken out of action on a natural 6.",
    "condition": "chef"
   }
  ]
 },
