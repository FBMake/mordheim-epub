  "reglesTexte": {
    "Grave Goods": {
      "fr": {
        "nom": "Biens funéraires",
        "resume": "Pendant la phase d'exploration, la bande gagne 1 co par figurine ennemie mise hors de combat (une fois par bataille)."
      },
      "en": {
        "nom": "Grave Goods",
        "resume": "In the Exploration phase, gain +1 gc per enemy model taken out of action (once per battle)."
      }
    },
    "Shady Reputation": {
      "fr": {
        "nom": "Réputation douteuse",
        "resume": "La bande ne peut engager ni chasseur de primes, ni patrouilleur, ni homme de loi, ni saint homme, ni aucun fidèle de Morr."
      },
      "en": {
        "nom": "Shady Reputation",
        "resume": "The warband cannot hire a Bounty Hunter, Roadwarden, Law-Enforcer, Holy Man or any follower of Morr."
      }
    },
    "Undead Foes": {
      "fr": {
        "nom": "Ennemis des morts",
        "resume": "Les guerriers de la bande haïssent les morts-vivants."
      },
      "en": {
        "nom": "Undead Foes",
        "resume": "Warband members hate Undead models."
      }
    },
    "Sawbones": {
      "fr": {
        "nom": "Charcutier",
        "resume": "Une fois après la partie, relance un résultat de blessure grave d'un héros ami (le second résultat s'applique), sauf si l'apprenti médecin a été mis hors de combat."
      },
      "en": {
        "nom": "Sawbones",
        "resume": "Re-roll one friendly hero's Serious Injury result (second result stands), unless the Junior Medic was taken out of action."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Pilleurs de tombes)",
    "listeEn": "Special Skills (Grave Robbers)",
    "competences": [
      {
        "en": "Darkstalker",
        "nom": "Rôdeur des ténèbres",
        "resume": "Ignore les tests « Seul contre tous » et peut doubler son Initiative pour repérer les figurines cachées.",
        "resumeEn": "Ignores All Alone tests and may double Initiative to spot Hidden models.",
        "condition": null
      },
      {
        "en": "Instinctual Violence",
        "nom": "Violence instinctive",
        "resume": "Pas de test de Peur quand il est chargé par des morts-vivants ; une de ses attaques peut frapper en premier.",
        "resumeEn": "No Fear test when charged by Undead; may nominate one attack to strike first.",
        "condition": null
      },
      {
        "en": "De-animator",
        "nom": "Désanimateur",
        "resume": "Ignore la règle Insensible à la douleur des morts-vivants et peut les sonner normalement.",
        "resumeEn": "Ignores Undead No Pain and may stun them normally.",
        "condition": null
      },
      {
        "en": "Hardy Constitution",
        "nom": "Constitution robuste",
        "resume": "Immunisé à toutes les maladies et aux poisons.",
        "resumeEn": "Immune to all diseases and poisons.",
        "condition": null
      },
      {
        "en": "Body Dealer",
        "nom": "Trafiquant de corps",
        "resume": "Sur 4+, récupère le corps et l'équipement d'un ami tué ; peut tenter de même pour un ennemi par une comparaison d'Initiative avec le chef adverse (égalité : rien ; défaite : il est capturé).",
        "resumeEn": "On a 4+, recovers the body and gear of a slain friend; may try for an enemy by an Initiative roll-off against the enemy leader (tie: nothing; loss: captured).",
        "condition": null
      }
    ]
  },
  "races": {},
  "notes": "Équipement « héros seulement » : pied-de-biche (10 co, parade, comme un gourdin), lanterne sourde et harnais (15+D6 co au comptoir, Rare 9 ; le porteur ne peut être vu), journal de chirurgien (80+4D6 co, Rare 11 ; le médecin modifie un dé de blessure grave de ±1 au lieu de Charcutier), pendentif de doigts (15 co ; sauvegarde unique 5+ contre la magie nécromantique) : prix fixes de base retenus. Pelle = hallebarde. Brutes : achetées par groupes de 1 à 5, nombre illimité. Pas de tableau de maximums ni de sorts : race humain."
}