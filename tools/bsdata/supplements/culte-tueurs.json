  "reglesTexte": {
    "Damnable Luck": {
      "fr": {
        "nom": "Chance maudite",
        "resume": "Après les jets de blessure d'après-partie, la bande peut relancer un résultat « mort » d'un seul tueur (héros ou homme de main) ; le second résultat s'applique."
      },
      "en": {
        "nom": "Damnable Luck",
        "resume": "After post-game injury rolls, re-roll one Dead result for a single Slayer; the second result stands."
      }
    },
    "No Armour, No Toys!": {
      "fr": {
        "nom": "Ni armure ni jouets !",
        "resume": "Les tueurs ne portent ni armure ni cape donnant une sauvegarde permanente (porte-bonheur permis), n'utilisent pas d'armes de tir autres que de jet et n'apprennent pas la magie."
      },
      "en": {
        "nom": "No Armour, No Toys!",
        "resume": "Slayers wear no armour or save-granting cloaks (lucky charms allowed), use no non-thrown missile weapons and learn no magic."
      }
    },
    "Only in Victory": {
      "fr": {
        "nom": "Seulement dans la victoire",
        "resume": "Les héros tueurs ne gagnent de dés d'exploration qu'en cas de victoire, d'égalité ou d'alliance avec le vainqueur (pas le chroniqueur)."
      },
      "en": {
        "nom": "Only in Victory",
        "resume": "Slayer heroes only get exploration dice on a win, tie or alliance with the winner (not the Rememberer)."
      }
    },
    "Record of Valor": {
      "fr": {
        "nom": "Registre de bravoure",
        "resume": "Si un héros tueur est mis hors de combat par un ennemi ou un PNJ alors que le chroniqueur est sur la table, la bande gagne un dé d'exploration supplémentaire. Un barde franc-tireur peut tenir ce rôle ; deux chroniqueurs ne se cumulent pas."
      },
      "en": {
        "nom": "Record of Valor",
        "resume": "If a Slayer hero is taken out of action by an enemy or NPC while the Rememberer is on the table, gain +1 exploration die. A Bard Hired Sword can do this too; two Rememberers don't stack."
      }
    },
    "Rememberer": {
      "fr": {
        "nom": "Chroniqueur",
        "resume": "Une fois par partie, un héros tueur à 6 ps ou moins peut relancer ses jets pour toucher ratés contre une grande cible ou une créature d'Endurance 5+. Le chroniqueur n'est pas un tueur et ne peut pas être chef."
      },
      "en": {
        "nom": "Rememberer",
        "resume": "Once per game, a Slayer hero within 6\" may re-roll failed to-hit rolls against a Large or Toughness 5+ creature. The Rememberer is not a Slayer and cannot lead."
      }
    },
    "Pick up the Slack": {
      "fr": {
        "nom": "Prendre le relais",
        "resume": "S'il n'a pas été mis hors de combat, le chroniqueur fait un jet de rareté ou de Dramatis Personae supplémentaire par héros tueur mis hors de combat pendant la partie."
      },
      "en": {
        "nom": "Pick up the Slack",
        "resume": "If not taken out of action, the Rememberer makes an extra rarity or Dramatis Personae roll per Slayer hero taken out of action that game."
      }
    },
    "Strong Arm": {
      "fr": {
        "nom": "Bras puissant",
        "resume": "Ajoute sa Force en pas à la portée des armes de jet."
      },
      "en": {
        "nom": "Strong Arm",
        "resume": "Adds his Strength in inches to thrown weapon range."
      }
    },
    "Born Marksmen": {
      "fr": {
        "nom": "Tireur né",
        "resume": "Sur « Ce gars a du talent », il peut toujours choisir les compétences de Tir."
      },
      "en": {
        "nom": "Born Marksmen",
        "resume": "On \"That Lad's Got Talent\" he may always pick Shooting skills."
      }
    },
    "Skittish": {
      "fr": {
        "nom": "Craintif",
        "resume": "Commence sans Vœu de mort et subit la psychologie normalement ; sur « Ce gars a du talent », il doit apprendre Vœu de mort."
      },
      "en": {
        "nom": "Skittish",
        "resume": "Starts without Deathwish and is subject to psychology; on \"That Lad's Got Talent\" he must learn Deathwish."
      }
    }
  },
