 "reglesTexte": {
  "Strategic Minded": {
   "fr": {
    "nom": "Esprit stratège",
    "resume": "La bande peut choisir de fuir avec une perte de moins que la normale."
   },
   "en": {
    "nom": "Strategic Minded",
    "resume": "The warband may choose to rout after suffering one fewer casualty than normal."
   }
  },
  "Ride": {
   "fr": {
    "nom": "Monte",
    "resume": "Possède la compétence Monte (règles de cavalerie) et peut monter un cheval ou un cheval de guerre."
   },
   "en": {
    "nom": "Ride",
    "resume": "Has the Ride skill from the cavalry rules and may ride a horse or warhorse."
   }
  },
  "Tenants of the Order": {
   "fr": {
    "nom": "Préceptes de l'ordre",
    "resume": "Vœu de pauvreté : ne peut porter qu'un bâton de marche (gourdin) et une dague."
   },
   "en": {
    "nom": "Tenants of the Order",
    "resume": "Vow of poverty: may carry only a walking staff (club) and a dagger."
   }
  },
  "Wizard (Vim-Toist Magic)": {
   "fr": {
    "nom": "Sorcier (Magie vim-toïste)",
    "resume": "Chef spirituel de la bande, il lance la magie vim-toïste (magie élémentaire arabienne) et commence avec un sort."
   },
   "en": {
    "nom": "Wizard (Vim-Toist Magic)",
    "resume": "Spiritual leader of the warband, casts Vim-Toist (Arabian Elemental) magic and starts with one spell."
   }
  },
  "Infiltration": {
   "fr": {
    "nom": "Infiltration",
    "resume": "Se déploie après l'adversaire, hors de sa vue et à plus de 12 ps de tout ennemi ; si les deux camps infiltrent, le plus faible résultat au D6 se place en premier."
   },
   "en": {
    "nom": "Infiltration",
    "resume": "Deploys after the enemy, out of sight and more than 12\" from any enemy; if both sides infiltrate, lowest D6 deploys first."
   }
  },
  "Loner": {
   "fr": {
    "nom": "Solitaire",
    "resume": "Ne peut jamais devenir chef de la bande."
   },
   "en": {
    "nom": "Loner",
    "resume": "Can never become the warband's leader."
   }
  },
  "Wall of Steel": {
   "fr": {
    "nom": "Mur d'acier",
    "resume": "Peut manier une lance à deux mains ; elle gagne alors la règle parade."
   },
   "en": {
    "nom": "Wall of Steel",
    "resume": "May wield a spear two-handed, giving it the parry rule."
   }
  },
  "Wardens of the Castle": {
   "fr": {
    "nom": "Gardiennes du château",
    "resume": "Cause la peur tant qu'elle se trouve dans un bâtiment ou des ruines (à définir avant la partie)."
   },
   "en": {
    "nom": "Wardens of the Castle",
    "resume": "Causes fear while inside buildings or ruins (agree which terrain counts before the game)."
   }
  }
