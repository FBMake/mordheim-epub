  "reglesTexte": {
    "Night Goblin Animosity": {
      "fr": {
        "nom": "Animosité des gobelins de la nuit",
        "resume": "Au début de chaque tour, lancez 1D6 : sur 1, les gobelins de la nuit se chamaillent et ne font rien d'autre ce tour ; trolls, squigs et snotlings ne sont pas concernés."
      },
      "en": {
        "nom": "Night Goblin Animosity",
        "resume": "At the start of each turn roll a D6: on a 1 the Night Goblins squabble and do nothing else that turn; Trolls, Squigs and Snotlings are unaffected."
      }
    },
    "Hate Stunties": {
      "fr": {
        "nom": "Haine des nabots",
        "resume": "Les gobelins de la nuit haïssent les Nains (sauf les fanatiques)."
      },
      "en": {
        "nom": "Hate Stunties",
        "resume": "Night Goblins hate Dwarfs (Fanatics excepted)."
      }
    },
    "Addict": {
      "fr": {
        "nom": "Accro",
        "resume": "Doit recevoir des champignons fous avant chaque partie, sinon il ne joue pas ; il les mange avant la bataille."
      },
      "en": {
        "nom": "Addict",
        "resume": "Must be given Mad Cap Mushrooms before each game or he sits it out; he eats them before the battle."
      }
    },
    "Mushroom Brain": {
      "fr": {
        "nom": "Cervelle de champignon",
        "resume": "Le fanatique ne gagne jamais d'expérience."
      },
      "en": {
        "nom": "Mushroom Brain",
        "resume": "The Fanatic never gains experience."
      }
    },
    "Looney": {
      "fr": {
        "nom": "Cinglé",
        "resume": "Sujet à la frénésie ; doit toujours lancer pour les blessures graves après la bataille."
      },
      "en": {
        "nom": "Looney",
        "resume": "Subject to frenzy; must always roll for serious injury after the battle."
      }
    },
    "Frantic": {
      "fr": {
        "nom": "Frénétique",
        "resume": "Frappe toujours en premier au corps à corps, quels que soient armes et Initiative."
      },
      "en": {
        "nom": "Frantic",
        "resume": "Always strikes first in close combat, regardless of weapons and Initiative."
      }
    },
    "Pointy Stick": {
      "fr": {
        "nom": "Bâton pointu",
        "resume": "Arme gratuite comptant comme une dague : +1 à la sauvegarde ennemie (6+ si l'ennemi n'en a pas)."
      },
      "en": {
        "nom": "Pointy Stick",
        "resume": "Free weapon counting as a dagger: enemy gets +1 to its armour save (6+ if it has none)."
      }
    },
    "Mob": {
      "fr": {
        "nom": "Grouillement",
        "resume": "Les snotlings se déplacent et combattent en groupe, à 1 ps les uns des autres, et rejoignent les combats ensemble."
      },
      "en": {
        "nom": "Mob",
        "resume": "Snotlings move and fight as a group within 1\" of each other and join combats together."
      }
    },
    "Weedy": {
      "fr": {
        "nom": "Chétif",
        "resume": "Blessé, un snotling est à terre sur 1, sonné sur 2-3 et hors de combat sur 4-6."
      },
      "en": {
        "nom": "Weedy",
        "resume": "When wounded a Snotling is knocked down on a 1, stunned on 2-3 and out of action on 4-6."
      }
    },
    "Dodgy": {
      "fr": {
        "nom": "Insaisissable",
        "resume": "Sauvegarde d'esquive de 6+ contre les tirs."
      },
      "en": {
        "nom": "Dodgy",
        "resume": "6+ dodge save against shooting."
      }
    },
    "Insignificant": {
      "fr": {
        "nom": "Insignifiant",
        "resume": "La bande de snotlings compte pour une seule figurine (déroute, effectif, revenus) ; un héros ennemi ne gagne d'expérience que pour le dernier snotling retiré."
      },
      "en": {
        "nom": "Insignificant",
        "resume": "The mob counts as one model for rout, warband size and income; an enemy Hero only gains experience for the last Snotling removed."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Gobelins de la nuit)",
    "listeEn": "Special Skills (Night Goblins)",
    "competences": [
      {
        "en": "Ded Shooty",
        "nom": "Tir d'enfer",
        "resume": "Ajoute 6 ps à la portée des armes de tir (pas des filets).",
        "resumeEn": "Adds 6\" to the range of missile weapons (not nets).",
        "condition": null
      },
      {
        "en": "Sneaky Git",
        "nom": "Sale fourbe",
        "resume": "Après tous les déploiements, déplace jusqu'à D3 membres de la bande.",
        "resumeEn": "After all deployment, moves up to D3 warband members.",
        "condition": "chef"
      },
      {
        "en": "Infiltrate",
        "nom": "Infiltration",
        "resume": "Se déploie après l'adversaire, hors de vue et à plus de 12 ps de l'ennemi.",
        "resumeEn": "Deploys after the enemy, out of sight and more than 12\" from enemy models.",
        "condition": null
      },
      {
        "en": "Netter",
        "nom": "Lanceur de filet",
        "resume": "Peut charger en lançant un filet : s'il touche et que la cible ne se libère pas, elle est à terre et la charge aboutit ; sinon la charge échoue.",
        "resumeEn": "May charge by throwing a net: if it hits and the target fails to escape, it is knocked down and the charge succeeds; otherwise the charge fails.",
        "condition": null
      }
    ]
  },
  "races": {},
  "notes": "Bande expérimentale (PDF broheim). La règle Leader du grand chef mentionne « Orc Boss » sur la page. Liste fanatique réservée aux fanatiques ; ils ne gagnent jamais d'expérience (Mushroom Brain) ; les champignons fous (25 co) doivent être rachetés avant chaque partie. Squigs : 0-5 et jamais plus que de gobelins de la nuit ; M 2D6. Troll : ne lance jamais pour les blessures graves ; entretien 15 co après chaque partie (Always Hungry). Bande de snotlings : 0-1, 5 snotlings pour 50 co (10 co par snotling de remplacement), saisie comme un seul guerrier ; elle compte pour une seule figurine dans l'effectif ; bâton pointu gratuit (dague). La page ne dit pas si les snotlings gagnent de l'expérience. Pas de filet dans les listes (la compétence Netter renvoie au livre de règles). Hommes de main par groupes de 1 à 5. Pas de tableau de maximums ni de variantes sur la page ; race gobelin utilisée."
}