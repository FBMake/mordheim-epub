  "reglesTexte": {
    "Scaly Skin": {
      "fr": {
        "nom": "Peau écailleuse",
        "resume": "Sauvegarde naturelle (saurus 5+, skinks 6+, kroxigor 4+), jamais dégradée au-delà de 6 par la Force et annulée par un coup critique « sans sauvegarde » ; armure légère et bouclier donnent chacun +1."
      },
      "en": {
        "nom": "Scaly Skin",
        "resume": "Natural save (Saurus 5+, Skinks 6+, Kroxigor 4+), never worse than 6 from Strength, negated by a 'no save' critical; light armour and shield each add +1."
      }
    },
    "Armour": {
      "fr": {
        "nom": "Armure saurienne",
        "resume": "Pour cette bande, l'armure légère coûte toujours 50 co, même achetée au tableau d'équipement général."
      },
      "en": {
        "nom": "Armour",
        "resume": "Light armour always costs this warband 50 gc, even from the general Equipment chart."
      }
    },
    "Bite Attack": {
      "fr": {
        "nom": "Morsure",
        "resume": "Les saurus ont une attaque de morsure supplémentaire à leur propre Force, sans pénalité d'arme ; elle frappe toujours en dernier."
      },
      "en": {
        "nom": "Bite Attack",
        "resume": "Saurus have an extra bite attack at their own Strength with no unarmed penalty; it always strikes last."
      }
    },
    "Cold Blooded": {
      "fr": {
        "nom": "Sang-froid",
        "resume": "Pour les tests de psychologie et de déroute, lancez 3D6 et gardez les deux plus faibles. Le Commandement d'un saurus ou d'un kroxigor ne peut servir aux tests de déroute."
      },
      "en": {
        "nom": "Cold Blooded",
        "resume": "Roll 3D6 and keep the lowest two for psychology and Rout tests. Saurus or Kroxigor Leadership may not be used for Rout tests."
      }
    },
    "Aquatic": {
      "fr": {
        "nom": "Amphibie",
        "resume": "Se déplace dans l'eau sans pénalité et y compte comme à couvert."
      },
      "en": {
        "nom": "Aquatic",
        "resume": "Moves through water without penalty and counts as in cover while in it."
      }
    },
    "Jungle Born": {
      "fr": {
        "nom": "Né dans la jungle",
        "resume": "Les skinks traversent la jungle sans pénalité de mouvement."
      },
      "en": {
        "nom": "Jungle Born",
        "resume": "Skinks move through jungle without penalty."
      }
    },
    "Saurus Rarity": {
      "fr": {
        "nom": "Rareté des saurus",
        "resume": "La bande ne peut jamais compter plus de braves saurus que de braves skinks."
      },
      "en": {
        "nom": "Saurus Rarity",
        "resume": "The warband may never have more Saurus Braves than Skink Braves."
      }
    },
    "Wizard (Lizardmen Magic)": {
      "fr": {
        "nom": "Sorcier (Magie des Hommes-Lézards)",
        "resume": "Le prêtre skink lance des sorts de la magie des Hommes-Lézards."
      },
      "en": {
        "nom": "Wizard (Lizardmen Magic)",
        "resume": "The Skink Priest casts Lizardmen magic spells."
      }
    }
  },
