  "reglesTexte": {
    "Hate Undead": {
      "fr": {
        "nom": "Haine des morts-vivants",
        "resume": "Les héros nomades d'Arabie haïssent tous les morts-vivants."
      },
      "en": {
        "nom": "Hate Undead",
        "resume": "Araby Nomad heroes hate all Undead."
      }
    },
    "Wizard (Elemental Magic)": {
      "fr": {
        "nom": "Sorcier (Magie élémentaire)",
        "resume": "Le mystique est un sorcier qui utilise la Magie élémentaire ; il commence avec un sort de cette liste tiré au hasard."
      },
      "en": {
        "nom": "Wizard (Elemental Magic)",
        "resume": "The Mystic is a wizard using Elemental Magic; he starts with one random spell from that list."
      }
    },
    "Desert Trader": {
      "fr": {
        "nom": "Marchand du désert",
        "resume": "La bande obtient +1 à ses jets de recherche d'objets rares au comptoir ; le bonus ne se cumule pas avec plusieurs Bédouins."
      },
      "en": {
        "nom": "Desert Trader",
        "resume": "The warband gets +1 when searching for rare items; the bonus does not stack with several Bedouin."
      }
    },
    "Life of Slavery": {
      "fr": {
        "nom": "Vie d'esclave",
        "resume": "Si un groupe d'esclaves obtient le résultat « Le gars a du talent », le chef exécute l'esclave, qui est rayé de la feuille ; le reste du groupe relance sa progression."
      },
      "en": {
        "nom": "Life of Slavery",
        "resume": "If a Slave group rolls 'The lad's got talent', the leader executes the slave, who is removed from the roster; the rest of the group re-rolls its advance."
      }
    }
  },
