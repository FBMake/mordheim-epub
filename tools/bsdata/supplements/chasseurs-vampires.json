  "reglesTexte": {
    "Stake the Vampire!": {
      "fr": {
        "nom": "Pieu dans le cœur !",
        "resume": "Le guerrier hait les vampires. Il doit se déplacer vers tout vampire visible, sauf s'il peut lui tirer dessus, auquel cas le joueur choisit."
      },
      "en": {
        "nom": "Stake the Vampire!",
        "resume": "Hates Vampires. Must move towards a visible Vampire unless he can shoot at it, in which case the player chooses."
      }
    },
    "Loner": {
      "fr": {
        "nom": "Solitaire",
        "resume": "Le prêtre ignore les règles de combat seul contre plusieurs (« Seul au monde »)."
      },
      "en": {
        "nom": "Loner",
        "resume": "The priest ignores the All Alone rules."
      }
    },
    "Prayers of Morr": {
      "fr": {
        "nom": "Prières de Morr (rites funéraires)",
        "resume": "Le prêtre connaît un rite funéraire de Morr tiré au hasard ; il l'accomplit comme un sort, dans la phase de magie."
      },
      "en": {
        "nom": "Prayers of Morr (Funerary Rites)",
        "resume": "The priest knows one random Funerary Rite of Morr, used like a spell in the magic phase."
      }
    },
    "Fanatical": {
      "fr": {
        "nom": "Fanatiques",
        "resume": "Les pèlerins réussissent automatiquement tous les tests basés sur le Commandement mais ne peuvent jamais devenir chef de la bande."
      },
      "en": {
        "nom": "Fanatical",
        "resume": "Automatically pass all Leadership-based tests but may never become the warband leader."
      }
    },
    "Blunt": {
      "fr": {
        "nom": "Armes contondantes",
        "resume": "Les pèlerins n'utilisent ni armes tranchantes ni armes de tir, seulement masses, marteaux et bâtons, à l'exception du pieu à pointe d'argent."
      },
      "en": {
        "nom": "Blunt",
        "resume": "Pilgrims shun bladed and missile weapons, using only maces, hammers and staffs, except the Silver-tip Stake."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Chasseurs de vampires de Sylvanie)",
    "listeEn": "Special Skills (Vampire Hunters of Sylvania)",
    "competences": [
      {
        "en": "Iron Will",
        "nom": "Volonté de fer",
        "resume": "Le héros est immunisé contre la Peur.",
        "resumeEn": "The hero is immune to Fear.",
        "condition": null
      },
      {
        "en": "Righteous Aura",
        "nom": "Aura de justice",
        "resume": "Lors du premier round de corps à corps, chaque adversaire possédé ou mort-vivant perd sa première attaque contre ce guerrier (minimum 1 attaque).",
        "resumeEn": "In the first round of close combat, Possessed or Undead opponents lose their first attack against this warrior (minimum 1).",
        "condition": null
      },
      {
        "en": "Thirst for Vengeance",
        "nom": "Soif de vengeance",
        "resume": "Le héros hait tous les morts-vivants et gagne +1 Attaque au tour où il charge.",
        "resumeEn": "The hero hates all Undead and gains +1 Attack in a turn in which he charged.",
        "condition": null
      },
      {
        "en": "Blessing of Morr",
        "nom": "Bénédiction de Morr",
        "resume": "+1 aux jets de blessure contre les morts-vivants.",
        "resumeEn": "+1 to injury rolls against Undead.",
        "condition": null
      },
      {
        "en": "Touch of Darkness",
        "nom": "Toucher des ténèbres",
        "resume": "Le héros ignore les pénalités liées à l'obscurité.",
        "resumeEn": "The hero ignores darkness penalties.",
        "condition": null
      }
    ]
  },
  "races": {},
  "notes": "Pieu à pointe d'argent : 10 co dans les listes, 15 co dans la section équipement spécial ; 10 retenu (F utilisateur, +1 au jet de blessure contre un vampire). Faux : F+1, deux mains. Gorgerin (Throat Guard, rare 7) : sauvegarde spéciale 6+ contre les blessures infligées par des vampires. Pistolet-arbalète marqué d'un astérisque sans note explicative. Carreaux bénis (Blessed Bolts) : renvoi vers la page Protectorat de Sigmar. Objets divers réservés aux héros. Prêtre de Morr : seulement dague et faux, jamais d'armure ; ses « Funerary Rites » sont saisis sous la clé « Prayers of Morr » (rites non saisis). Il peut aussi prendre Bénédiction de Morr et Soif de vengeance de la liste spéciale (la page dit que chasseur et tueurs utilisent cette liste « au lieu » des listes standard, mais le tableau d'accès leur donne aussi les listes standard : tableau retenu). Villageois : nombre illimité. Francs-tireurs : comme une bande de mercenaires humains. La page de composition dit « A Slayer Warband » (coquille)."
}