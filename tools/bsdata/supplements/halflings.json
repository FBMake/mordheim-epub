        "nom": "Couches de graisse",
        "resume": "Sauvegarde de base de 6 quelle que soit la Force adverse, en plus de l'armure.",
        "resumeEn": "Basic 6+ save regardless of attacker's Strength, in addition to armour.",
        "condition": null
      },
      {
        "en": "Shifty",
        "nom": "Fuyant",
        "resume": "Quand il est chargé, gagne une attaque bonus qui frappe en premier.",
        "resumeEn": "When charged, gains a bonus attack that strikes first.",
        "condition": null
      }
