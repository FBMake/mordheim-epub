  "reglesTexte": {
    "Pretty Much Human": {
      "fr": {
        "nom": "Presque humains",
        "resume": "Les halflings peuvent engager tous les francs-tireurs accessibles aux mercenaires humains."
      },
      "en": {
        "nom": "Pretty Much Human",
        "resume": "Halflings may hire any Hired Sword available to human mercenaries."
      }
    },
    "Too Big": {
      "fr": {
        "nom": "Trop grand",
        "resume": "Les halflings ne peuvent jamais utiliser arc long, arc elfique, arquebuse, long fusil ni tromblon, même via une progression."
      },
      "en": {
        "nom": "Too Big",
        "resume": "Halflings may never use longbows, elf bows, handguns, long rifles or blunderbusses, even through advances."
      }
    },
    "Halfling Items": {
      "fr": {
        "nom": "Objets halflings",
        "resume": "Les objets halflings (livre de cuisine halfling, etc.) n'apportent aucun bonus à la bande."
      },
      "en": {
        "nom": "Halfling Items",
        "resume": "Halfling items such as the Halfling Cookbook give this warband no bonus."
      }
    },
    "Master Chef": {
      "fr": {
        "nom": "Maître cuisinier",
        "resume": "À la vente de trésors ou de malepierre, sur 5+ au D6 la bande compte comme d'une taille inférieure."
      },
      "en": {
        "nom": "Master Chef",
        "resume": "When selling treasure or Wyrdstone, on a 5+ the warband counts as one size smaller."
      }
    },
    "Infiltration": {
      "fr": {
        "nom": "Infiltration",
        "resume": "Se déploie après l'adversaire, hors de sa vue et à au moins 12 ps de tout ennemi ; si plusieurs figurines infiltrent, jet pour l'ordre."
      },
      "en": {
        "nom": "Infiltration",
        "resume": "Deploys after the enemy, out of sight and at least 12\" from any enemy; roll off if several models infiltrate."
      }
    },
    "Pick Locks": {
      "fr": {
        "nom": "Crocheteur",
        "resume": "Ouvrir une porte verrouillée ne demande qu'un test d'Initiative réussi."
      },
      "en": {
        "nom": "Pick Locks",
        "resume": "Opening a locked door needs only a passed Initiative test."
      }
    },
    "Cutpurse": {
      "fr": {
        "nom": "Coupe-bourse",
        "resume": "Si le voleur combat sans être mis hors de combat, la bande gagne un trésor de plus."
      },
      "en": {
        "nom": "Cutpurse",
        "resume": "If the Thief fights and is not taken out of action, the warband gains +1 Treasure."
      }
    },
    "Protective": {
      "fr": {
        "nom": "Protecteur",
        "resume": "Une fois l'ogre du village recruté, aucun garde du corps ogre ne peut rejoindre la bande (celui déjà engagé part)."
      },
      "en": {
        "nom": "Protective",
        "resume": "Once a Village Ogre is hired, no Ogre Bodyguard may join; one already hired leaves."
      }
    }
  },
