  "reglesTexte": {
    "Enemies of Morr": {
      "fr": {
        "nom": "Ennemis de Morr",
        "resume": "Les membres de la bande ne craignent pas les vampires, nécromanciens et morts-vivants : ils ignorent la Peur qu'ils causent."
      },
      "en": {
        "nom": "Enemies of Morr",
        "resume": "Warband members are not affected by Fear caused by vampires, necromancers or their undead."
      }
    },
    "Chosen of Morr": {
      "fr": {
        "nom": "Élu de Morr",
        "resume": "Pour recruter le Rêveur, un prêtre de Morr doit l'authentifier : sur 4+ au D6 il rejoint la bande et la mène ; sinon le prêtre est le chef. On peut réessayer après chaque bataille en payant le coût ; une fois un vrai Rêveur mort, on ne peut plus en recruter et le prêtre redevient chef."
      },
      "en": {
        "nom": "Chosen of Morr",
        "resume": "A Priest of Morr must vouch for the Dreamer: on a 4+ he is hired and leads the warband, otherwise the Priest is the leader. The roll may be retried after any battle by paying the cost; once a true Dreamer dies no other can be hired and leadership returns to the Priest."
      }
    },
    "Guiding Dream": {
      "fr": {
        "nom": "Rêve guide",
        "resume": "Au début de chaque bataille le Rêveur lance 1D6 : 1, -1 ps de Mouvement ; 2-3, +1 pour toucher un héros ennemi choisi ; 4-5, +1 en Force contre lui ; 6, Frénésie contre lui."
      },
      "en": {
        "nom": "Guiding Dream",
        "resume": "Each battle the Dreamer rolls a D6: 1, -1\" Movement; 2-3, +1 to hit a chosen enemy hero; 4-5, +1 Strength against it; 6, Frenzy against it."
      }
    },
    "Hate Undead": {
      "fr": {
        "nom": "Haine des morts-vivants",
        "resume": "Ce guerrier hait les vampires, les nécromanciens et tous les morts-vivants."
      },
      "en": {
        "nom": "Hate Undead",
        "resume": "This warrior hates vampires, necromancers and all undead."
      }
    },
    "Prayers of Morr": {
      "fr": {
        "nom": "Prières de Morr",
        "resume": "Le prêtre accomplit les Rites funéraires de Morr (liste décrite dans la section Magie) ; il ne peut porter aucune armure et n'utilise que dague et faux."
      },
      "en": {
        "nom": "Prayers of Morr",
        "resume": "The Priest performs the Funerary Rites of Morr (listed in the Magic section); he may never wear armour and uses only a dagger and a scythe."
      }
    },
    "Loner": {
      "fr": {
        "nom": "Solitaire",
        "resume": "Ce guerrier n'effectue jamais de test « Seul contre tous »."
      },
      "en": {
        "nom": "Loner",
        "resume": "This warrior never takes All Alone tests."
      }
    },
    "Silent Guardian": {
      "fr": {
        "nom": "Gardien silencieux",
        "resume": "Un ennemi doit réussir un test d'Initiative pour repérer un garde noir caché ; son armure ne le ralentit pas."
      },
      "en": {
        "nom": "Silent Guardian",
        "resume": "Enemies must pass an Initiative test to spot a Hidden Black Guard; armour does not slow him."
      }
    },
    "Estalian Technique": {
      "fr": {
        "nom": "Technique estalienne",
        "resume": "L'Andanti peut parer avec une rapière ou une main gauche en utilisant sa Capacité de Combat."
      },
      "en": {
        "nom": "Estalian Technique",
        "resume": "The Andanti may parry with a rapier or main gauche using his Weapon Skill."
      }
    },
    "Andanti Knowledge": {
      "fr": {
        "nom": "Savoir des Andanti",
        "resume": "+1 pour toucher les vampires au corps à corps."
      },
      "en": {
        "nom": "Andanti Knowledge",
        "resume": "+1 to hit vampires in close combat."
      }
    },
    "Expert Halberdier": {
      "fr": {
        "nom": "Hallebardier expert",
        "resume": "Peut manier une hallebarde d'une main et porter un bouclier de l'autre."
      },
      "en": {
        "nom": "Expert Halberdier",
        "resume": "May wield a halberd one-handed with a shield in the other hand."
      }
    }
  },
