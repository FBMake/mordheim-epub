  "reglesTexte": {
    "Don't Trust 'Em": {
      "fr": {
        "nom": "Pas confiance",
        "resume": "Les Rangers peuvent s'allier à d'autres bandes naines en multijoueur sans être des figurines amies : elles se gênent pour marcher et ne s'aident pas pour les tests « Seul contre tous », mais ne sont pas ennemies et partagent normalement les trésors."
      },
      "en": {
        "nom": "Don't Trust 'Em",
        "resume": "Rangers may ally with other Dwarf warbands in multiplayer games but are not friendly models: they block each other's marching and give no help for All Alone tests, though they are not enemies and share treasure normally."
      }
    },
    "Inscribe Runes": {
      "fr": {
        "nom": "Graver les runes",
        "resume": "Il commence avec une rune mineure tirée au hasard et peut, à chaque progression, apprendre une nouvelle rune au lieu d'une compétence. Avant chaque partie il grave une rune sur un objet (2D6 ≥ difficulté ; un 2 détruit l'objet)."
      },
      "en": {
        "nom": "Inscribe Runes",
        "resume": "He starts with one random minor rune and may learn a new rune instead of a skill when advancing. Before each game he inscribes a rune on an item (2D6 ≥ difficulty; a 2 destroys the item)."
      }
    },
    "Extra Set of Hands": {
      "fr": {
        "nom": "Une paire de mains en plus",
        "resume": "Avec l'apprenti, le forgeron des runes peut graver deux objets avant chaque partie au lieu d'un."
      },
      "en": {
        "nom": "Extra Set of Hands",
        "resume": "With the apprentice, the Runesmith may inscribe two items before each game instead of one."
      }
    },
    "Stubborn": {
      "fr": {
        "nom": "Têtus",
        "resume": "Ils peuvent relancer un test de Commandement raté ; une relance ne peut pas être relancée."
      },
      "en": {
        "nom": "Stubborn",
        "resume": "They may re-roll one failed Leadership test; a re-roll cannot be re-rolled."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Rangers nains)",
    "listeEn": "Special Skills (Dwarf Rangers)",
    "competences": [
      {
        "en": "Combat Master",
        "nom": "Maître du combat",
        "resume": "Ses parades réussissent aussi en cas d'égalité avec le meilleur jet pour toucher adverse ; avec deux armes de parade, il peut parer deux attaques.",
        "resumeEn": "His parries also succeed on a tie with the opponent's highest to-hit roll; with two parrying weapons he may parry two attacks.",
        "condition": null
      },
      {
        "en": "Extra Tough",
        "nom": "Extrêmement résistant",
        "resume": "Après une partie où il a été mis hors de combat, il peut relancer une fois son jet de blessure grave et garde le nouveau résultat.",
        "resumeEn": "After a game in which he was taken out of action, he may re-roll his Serious Injury roll once and keep the new result.",
        "condition": null
      },
      {
        "en": "Resource Hunter",
        "nom": "Chercheur de ressources",
        "resume": "Il peut modifier un dé d'exploration de +1 ou -1.",
        "resumeEn": "He may modify one Exploration die by +1 or -1.",
        "condition": null
      },
      {
        "en": "True Grit",
        "nom": "Cran",
        "resume": "Ses jets de blessure sont décalés : 1-3 à terre, 4-5 sonné, 6 hors de combat.",
        "resumeEn": "His injury rolls are shifted: 1-3 knocked down, 4-5 stunned, 6 out of action.",
        "condition": null
      },
      {
        "en": "Thick Skull",
        "nom": "Crâne épais",
        "resume": "Sauvegarde de 3+ (2+ avec un casque) contre l'étourdissement : un « sonné » sauvegardé devient « à terre ».",
        "resumeEn": "3+ save (2+ with a helmet) against being stunned: a saved stun becomes knocked down.",
        "condition": null
      },
      {
        "en": "Ferocious Charge",
        "nom": "Charge féroce",
        "resume": "Il double ses Attaques le tour où il charge, mais subit -1 pour toucher ce tour-là.",
        "resumeEn": "He doubles his Attacks on the turn he charges, at -1 to hit that turn.",
        "condition": "rangers-nains/troll-slayer"
      },
      {
        "en": "Monster Slayer",
        "nom": "Tueur de monstres",
        "resume": "Il blesse toujours sur 4+, quelle que soit l'Endurance de la cible, sauf si sa Force lui permet de faire mieux.",
        "resumeEn": "He always wounds on 4+ regardless of Toughness, unless his Strength would need a lower roll.",
        "condition": "rangers-nains/troll-slayer"
      },
      {
        "en": "Berserker",
        "nom": "Forcené",
        "resume": "+1 pour toucher le tour où il charge.",
        "resumeEn": "+1 to hit on the turn he charges.",
        "condition": "rangers-nains/troll-slayer"
      }
    ]
