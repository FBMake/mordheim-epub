  "reglesTexte": {
    "Woodcraft": {
      "fr": {
        "nom": "Science des bois",
        "resume": "Les figurines de la bande ne subissent aucune pénalité de mouvement en terrain difficile."
      },
      "en": {
        "nom": "Woodcraft",
        "resume": "Models in the warband suffer no movement penalty for difficult terrain."
      }
    },
    "Hang the Bandit!": {
      "fr": {
        "nom": "Pendez le brigand !",
        "resume": "Ce guerrier hait les bandits et les hors-la-loi (règles de haine)."
      },
      "en": {
        "nom": "Hang the Bandit!",
        "resume": "This warrior hates Bandits and Outlaws."
      }
    },
    "Infiltration": {
      "fr": {
        "nom": "Infiltration",
        "resume": "Se déploie après la bande adverse, n'importe où hors de vue de l'ennemi et à plus de 12 ps de toute figurine ennemie ; si les deux camps ont des infiltrateurs, chacun lance 1D6 et le plus faible se place en premier."
      },
      "en": {
        "nom": "Infiltration",
        "resume": "Deploys after the enemy warband, anywhere out of enemy sight and over 12\" from any enemy; if both sides have infiltrators, each rolls a D6 and the lowest sets up first."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Chasseurs cornus)",
    "listeEn": "Special Skills (Horned Hunters)",
    "competences": [
      {
        "en": "Master Trapper",
        "nom": "Maître trappeur",
        "resume": "Le fil de piège du guerrier porte à 4 ps et ses pièges se déclenchent sur 2+.",
        "resumeEn": "The warrior's trip wire reaches 4\" and his traps trigger on a 2+.",
        "condition": null
      },
      {
        "en": "Infiltration",
        "nom": "Infiltration",
        "resume": "Le guerrier gagne la règle Infiltration : il se déploie après l'adversaire, hors de vue et à plus de 12 ps de tout ennemi.",
        "resumeEn": "The warrior gains the Infiltration rule: he deploys after the enemy, out of sight and over 12\" from any enemy.",
        "condition": null
      },
      {
        "en": "Foul Odour",
        "nom": "Odeur infecte",
        "resume": "Les ennemis vivants (ni morts-vivants ni possédés) ont -1 pour toucher ce guerrier au corps à corps ; il ne peut porter de flamme nue et les attaques de feu contre lui ont +1 en Force.",
        "resumeEn": "Living enemies (not Undead or Possessed) suffer -1 to hit him in close combat; he cannot carry open flames and fire attacks against him get +1 Strength.",
        "condition": null
      },
      {
        "en": "Animal Friendship",
        "nom": "Amitié animale",
        "resume": "Les animaux ordinaires n'attaquent jamais ce guerrier, et jusqu'à deux de ses chiens de guerre ne comptent pas dans l'effectif maximum de la bande.",
        "resumeEn": "Normal animals never attack this warrior, and up to two of his warhounds do not count towards the warband's maximum size.",
        "condition": null
      },
      {
        "en": "Pathfinder",
        "nom": "Pisteur",
        "resume": "La bande lance un dé supplémentaire lors de la phase d'exploration ; une seule figurine de la bande peut avoir cette compétence.",
        "resumeEn": "The warband rolls one extra die in the exploration phase; only one warrior per warband may have this skill.",
        "condition": null
      },
      {
        "en": "Hide in Shadows",
        "nom": "Se fondre dans l'ombre",
        "resume": "Les ennemis qui tentent de repérer ce guerrier caché utilisent la moitié de leur Initiative.",
        "resumeEn": "Enemies trying to spot this warrior while Hidden halve their Initiative.",
        "condition": null
      }
    ]
  },
  "races": {},
  "notes": "Source Nemesis Crown (grade 1b). Taille 3 à 12 figurines ; exactement un Chasseur cornu. Le Prêtre de Taal ne peut jamais porter d'armure lourde (aucune dans sa liste de toute façon) ; Initiés et Fanatiques ne peuvent jamais porter d'armure : catégorie Armures retirée de leurs listes. La clé « Strictures » couvre donc deux interdits différents selon le guerrier. Fanatiques : nombre illimité. Chiens de guerre : 0-5, aucun équipement, profil F 4 tel que sur la page. Lance à 5 co et Masse/Marteau à 3 co (un seul objet) tels que sur la page. Cuirs renforcés, Peau de cerf bénie et Fil de piège : prix seulement, aucune description sur la page (noms anglais « Trip wire », « Blessed Stag Hide » repris de la page). Le Prêtre n'a pas accès au Tir. Pas de tableau de maximums : profil humain."
}