  "reglesTexte": {
    "Hate Skaven": {
      "fr": {
        "nom": "Haine des Skavens",
        "resume": "Depuis l'épidémie de vérole rouge de 1812, tous les Miragliens haïssent les Skavens (règles de haine) ; les francs-tireurs ne sont pas concernés et la bande ne peut pas engager de franc-tireur skaven."
      },
      "en": {
        "nom": "Hate Skaven",
        "resume": "Since the red pox of 1812 all Miragleans hate Skaven; Hired Swords are not affected, and the warband may not hire Skaven Hired Swords."
      }
    },
    "Miraglean Crossbows": {
      "fr": {
        "nom": "Arbalétriers miragliens",
        "resume": "Les héros miragliens ont +1 pour toucher lorsqu'ils tirent à l'arbalète (uniquement avec cette arme)."
      },
      "en": {
        "nom": "Miraglean Crossbows",
        "resume": "Miraglean Heroes get +1 to hit when shooting with crossbows only."
      }
    },
    "Miraglean Marksmen": {
      "fr": {
        "nom": "Tireurs miragliens",
        "resume": "Ces tireurs ont +1 pour toucher avec toutes leurs armes de tir."
      },
      "en": {
        "nom": "Miraglean Marksmen",
        "resume": "These Marksmen get +1 to hit with any missile weapon."
      }
    },
    "Cloak & Dagger": {
      "fr": {
        "nom": "Cape et dague",
        "resume": "Le duelliste se sert de sa cape pour détourner les coups : il compte comme équipé d'une rondache au corps à corps."
      },
      "en": {
        "nom": "Cloak & Dagger",
        "resume": "The duellist uses his cloak to deflect blows and counts as having a buckler in close combat."
      }
    }
  },
  "competencesSpeciales": null,
  "races": {},
  "notes": "Variante Miragliano (« Miragleans ») de la bande tiléenne ; les règles de Remas et Trantio sont ignorées. La page dit « 500 points » pour constituer la bande (saisi comme 500 co). Taille 3 à 15. Profil du Capitaine avec A 2 tel qu'écrit sur la page (inhabituel, mais confirmé par deux lectures). I 3 des Tireurs et Vitesse des Jeunes sangs portent une icône d'édition sur la page. Clés anglaises des règles miragliennes choisies par moi (la page ne les nomme pas). Pistolets à 15/30 co et pistolets de duel à 25/50 co (tarifs tiléens). Arquebuse 35 co et Fusil de chasse 200 co (liste des Tireurs) tels que sur la page. Pas de liste de compétences spéciales."
}