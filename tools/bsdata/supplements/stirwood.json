  "reglesTexte": {
    "Forest Bowmen": {
      "fr": {
        "nom": "Archers de la forêt",
        "resume": "Chaque guerrier doit porter un arc (pas d'arbalète) et ne peut avoir qu'une seule arme de tir, même si une compétence en permettrait davantage ; le Prêtre peut se passer d'arc."
      },
      "en": {
        "nom": "Forest Bowmen",
        "resume": "Every warrior must carry some kind of bow (never a crossbow) and may have only one missile weapon, whatever his skills; the Cleric need not carry a bow."
      }
    },
    "Restricted Hired Swords": {
      "fr": {
        "nom": "Francs-tireurs interdits",
        "resume": "La bande ne peut pas engager de Chasseur de primes, de Prêtre-loup d'Ulric, de Chaman norse ni d'Assassin elfe noir."
      },
      "en": {
        "nom": "Restricted Hired Swords",
        "resume": "The warband may not hire a Bounty Hunter, Wolf-Priest of Ulric, Norse Shaman or Dark Elf Assassin."
      }
    },
    "Disciple of Sigmar": {
      "fr": {
        "nom": "Disciple de Sigmar",
        "resume": "Le Prêtre commence la campagne en connaissant une Prière de Sigmar ; il peut porter une armure mais ne peut pas apprendre Sorcellerie ni Savoir arcanique."
      },
      "en": {
        "nom": "Disciple of Sigmar",
        "resume": "The Cleric starts knowing one Prayer of Sigmar; he may wear armour but may not learn Sorcery or Arcane Lore."
      }
    }
  },
  "competencesSpeciales": null,
  "races": {},
  "notes": "Taille 3 à 15. Le Prêtre (0-1) ne peut être recruté qu'à la place d'un Champion ou d'un Petit voleur ; il connaît une Prière de Sigmar au départ (non précisée). Une seule liste d'équipement : Arc long, Armure légère et Flèches de chasse réservés aux héros et Tireurs, Cape forestière (50 co, aucune règle donnée sur la page) réservée aux héros ; les Hors-la-loi ont donc une liste réduite. Flèches de chasse sans jet de rareté au recrutement initial des héros. « Staff/Club/Mace » = une entrée à 3 co. Clés anglaises des règles de bande choisies par moi (la page ne les nomme pas). Pas de liste de compétences spéciales."
}