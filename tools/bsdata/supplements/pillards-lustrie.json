  "reglesTexte": {
    "Chosen Leader": {
      "fr": {
        "nom": "Chef désigné",
        "resume": "La bande doit compter au moins un héros ; n'importe lequel peut être désigné comme chef."
      },
      "en": {
        "nom": "Chosen Leader",
        "resume": "The warband needs at least one Hero, and any Hero may be designated as its leader."
      }
    },
    "Rare Heroes": {
      "fr": {
        "nom": "Héros uniques",
        "resume": "Chaque type de héros ne peut être recruté qu'une seule fois pendant toute l'existence de la bande."
      },
      "en": {
        "nom": "Rare Heroes",
        "resume": "Each Hero type may be hired only once during the whole life of the warband."
      }
    },
    "Promotions": {
      "fr": {
        "nom": "Promotions",
        "resume": "Un héros perdu n'est pas remplacé : un aspirant est promu à sa place, récupère son équipement, choisit deux listes de compétences et fait aussitôt un jet de progression de héros."
      },
      "en": {
        "nom": "Promotions",
        "resume": "A lost Hero cannot be rebought: a Prospect is promoted in his place, keeps his gear, picks two skill lists and immediately rolls once on the Hero advance table."
      }
    },
    "Survivor": {
