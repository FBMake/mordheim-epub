 "reglesTexte": {
  "Seafaring": {
   "fr": {
    "nom": "Marins",
    "resume": "Les Norses gagnent +2 en Force lorsqu'ils rament dans une embarcation (ne sert que dans le scénario « Le manuscrit de Sigmar »)."
   },
   "en": {
    "nom": "Seafaring",
    "resume": "Norse get +2 Strength when rowing a boat (only used in the scenario The Script of Sigmar)."
   }
  },
  "Bestial": {
   "fr": {
    "nom": "Bestial",
    "resume": "Le Wulfen est insensible à la psychologie, ne peut jamais devenir chef de bande, et n'utilise ni arme ni armure sans subir de pénalité pour combattre à mains nues."
   },
   "en": {
    "nom": "Bestial",
    "resume": "The Wulfen is immune to psychology, can never become the warband leader, and uses no weapons or armour without the usual unarmed penalty."
   }
  },
  "Pack Leader": {
   "fr": {
    "nom": "Chef de meute",
    "resume": "Les loups ne peuvent être recrutés et utilisés que si la bande compte un Wulfen ; si celui-ci meurt ou est indisponible, ils restent inutilisables jusqu'à son remplacement."
   },
   "en": {
    "nom": "Pack Leader",
    "resume": "Wolves may only be used if the warband includes a Wulfen; if he is lost, they cannot be used until he is replaced."
   }
  }
 },
 "competencesSpeciales": {
  "liste": "Spéciales (Norses)",
  "listeEn": "Special Skills (Norse)",
  "competences": [
   {
    "en": "Barbarian Courage",
    "nom": "Courage barbare",
    "resume": "Il ne fait jamais de test « seul contre tous » et peut relancer les tests de Peur ratés.",
    "resumeEn": "He never takes All Alone tests and may re-roll failed Fear tests.",
    "condition": null
   },
   {
    "en": "Battle Tongue",
    "nom": "Voix de commandement",
    "resume": "Les guerriers à 12 ps (au lieu de 6) peuvent utiliser son Commandement.",
    "resumeEn": "Warriors within 12\" (instead of 6\") may use his Leadership.",
    "condition": "chef"
   },
   {
    "en": "Berserk Charge",
    "nom": "Charge berserk",
    "resume": "Armé d'une hache ou d'une arme lourde, il relance tous les jets pour toucher ratés lorsqu'il charge.",
    "resumeEn": "When armed with an axe or double-handed weapon, he re-rolls all failed to-hit rolls when charging.",
    "condition": null
   },
   {
    "en": "Crushing Blow",
    "nom": "Coup écrasant",
    "resume": "Ses attaques ne peuvent pas être parées.",
    "resumeEn": "His attacks cannot be parried.",
    "condition": null
   },
   {
    "en": "Shield Master",
    "nom": "Maître du bouclier",
    "resume": "Armé d'un bouclier, il peut parer avec, en plus de la sauvegarde de 6+ qu'il procure.",
    "resumeEn": "When armed with a shield he may parry with it, in addition to its 6+ save.",
    "condition": null
   }
  ]
 },
 "races": {},
 "notes": "Effectif min 3. Variante 1b (Town Cryer 13) suivie ; identique à la version 1c (Border Town Burning) hormis les PV du Wulfen : 2 PV retenu (correction confirmée par l'auteur, la table 1b imprimait 1). Le Wulfen est nommé « Ulfwerenar » dans la table de compétences ; pas d'arme ni d'armure, race null (maximums inconnus). Berserkers : liste des héros sans armure (bouclier/casque/armure exclus par prudence : la page dit « no armour »). Loups : seulement si la bande a un Wulfen. Haches de lancer = couteaux de lancer. Charge berserk et Maître du bouclier dépendent de l'arme (condition null)."
}