  "reglesTexte": {
    "Halflings": {
      "fr": {
        "nom": "Halflings",
        "resume": "Les halflings sont si frêles qu'un résultat de 2 sur leurs jets de blessure compte comme « sonné »."
      },
      "en": {
        "nom": "Halflings",
        "resume": "Halflings are so puny that a roll of 2 on their injury rolls counts as 'stunned'."
      }
    },
    "Inspired Cooking": {
      "fr": {
        "nom": "Cuisine inspirée",
        "resume": "Les halflings à 6 ps ou moins du maître cuisinier peuvent relancer leurs jets pour toucher ratés au corps à corps, une fois par tour."
      },
      "en": {
        "nom": "Inspired Cooking",
        "resume": "Halflings within 6\" of the Master Chef may re-roll failed to-hit rolls in close combat, once per turn."
      }
    },
    "Sneaky": {
      "fr": {
        "nom": "Sournois",
        "resume": "Les tirs visant un voleur halfling subissent toujours -1 pour toucher, en plus des autres modificateurs."
      },
      "en": {
        "nom": "Sneaky",
        "resume": "Shots at a Halfling Thief always suffer -1 to hit, on top of other modifiers."
      }
    },
    "Keen Eyesight": {
      "fr": {
        "nom": "Vue perçante",
        "resume": "L'éclaireur repère les ennemis cachés à une distance égale au double de son Initiative en ps."
      },
      "en": {
        "nom": "Keen Eyesight",
        "resume": "The scout spots hidden enemies at twice his Initiative in inches."
      }
    }
  },
  "competencesSpeciales": null,
  "races": {},
  "notes": "Source Citadel Journal 36 (grade 1b). Taille 3 à 20. Voleurs halflings 0-3 : la page imprimée indiquait « 0-2 » dans l'en-tête mais « trois » dans le texte ; la page retient 0-3. Pistolet (15 co) réservé à l'Ancien du Moot. Le Maître cuisinier n'utilise que la liste d'ustensiles (Couteau de cuisine, Couperet, Louche, Attendrisseur ; aucune règle donnée pour ces objets, pas de dague gratuite indiquée). Casque-marmite 8 co sans règle donnée. Pas de compétences spéciales. Race halfling (maximums existants)."
}