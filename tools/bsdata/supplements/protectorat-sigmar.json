 "reglesTexte": {
  "Death of a Leader": {
   "fr": {
    "nom": "Mort du chef",
    "resume": "Si le prêtre-guerrier meurt, l'acolyte le plus expérimenté prend la tête de la bande avec ses avantages mais sans prière ; il pourra en prendre une à sa prochaine progression. Un nouvel acolyte peut alors être recruté."
   },
   "en": {
    "nom": "Death of a Leader",
    "resume": "If the Warrior Priest dies, the most experienced Acolyte becomes leader with his benefits but no prayer; he may take one at his next advance. Another Acolyte may then be hired."
   }
  },
  "Witch Hunter Hired Swords": {
   "fr": {
    "nom": "Francs-tireurs des répurgateurs",
    "resume": "La bande recrute ses francs-tireurs comme une bande de répurgateurs."
   },
   "en": {
    "nom": "Witch Hunter Hired Swords",
    "resume": "The warband hires Hired Swords as if it were a Witch Hunter warband."
   }
  },
  "Zealous": {
   "fr": {
    "nom": "Zélé",
    "resume": "Le templier hait toute figurine d'une bande chaotique (skavens, possédés, carnaval du Chaos, hommes-bêtes, bandes comptant un démon)."
   },
   "en": {
    "nom": "Zealous",
    "resume": "The Templar hates every model from a chaotic warband (Skaven, Possessed, Carnival of Chaos, Beastmen, any warband with a Daemon)."
   }
  },
  "Beastmaster (Huntsman)": {
   "fr": {
    "nom": "Maître des bêtes",
    "resume": "Les animaux de la bande à 6 ps ou moins peuvent utiliser son Commandement ; les bêtes ennemies doivent réussir un test de Commandement pour le charger."
   },
   "en": {
    "nom": "Beastmaster (Huntsman)",
    "resume": "Warband animals within 6\" may use his Leadership; hostile beasts must pass a Leadership test to charge him."
   }
  },
  "Devoted": {
   "fr": {
    "nom": "Dévoué",
    "resume": "Le molosse peut relancer un test de Commandement raté s'il est à 12 ps ou moins du prêtre-guerrier."
   },
   "en": {
    "nom": "Devoted",
    "resume": "A Hound may re-roll a failed Leadership test if within 12\" of the Warrior Priest."
   }
  },
  "Jaws and Brutality": {
   "fr": {
    "nom": "Crocs et brutalité",
    "resume": "Les molosses n'utilisent jamais d'armes ni d'armure et ne subissent aucune pénalité pour cela."
   },
   "en": {
    "nom": "Jaws and Brutality",
    "resume": "Hounds never use weapons or armour and suffer no penalty for it."
   }
  }
 },
 "competencesSpeciales": {
