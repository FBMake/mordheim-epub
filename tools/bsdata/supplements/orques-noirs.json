  "reglesTexte": {
    "Let the Goons Do the Work": {
      "fr": {
        "nom": "Laisser le boulot aux larbins",
        "resume": "Les Orques noirs combattent à pied et ne montent jamais : seuls les Orques ordinaires peuvent chevaucher un sanglier ou une monture similaire."
      },
      "en": {
        "nom": "Let the Goons Do the Work",
        "resume": "Black Orcs fight on foot and never ride: only ordinary Orcs may ride a boar or similar mount."
      }
    },
    "Da Boss is Dead!": {
      "fr": {
        "nom": "Le boss est mort !",
        "resume": "Si le chef meurt, un Orque noir prend la tête de la bande en priorité, quelle que soit son expérience, et gagne « Oi Behave! »."
      },
      "en": {
        "nom": "Da Boss is Dead!",
        "resume": "If the Boss dies, a Black Orc takes command first, whatever his experience, and gains 'Oi Behave!'."
      }
    },
    "Black Orc": {
      "fr": {
        "nom": "Orque noir",
        "resume": "Il bénéficie d'une sauvegarde d'armure naturelle de 6+, cumulable avec son équipement."
      },
      "en": {
        "nom": "Black Orc",
        "resume": "He has a natural 6+ armour save, which combines with his equipment."
      }
    },
    "Oi Behave!": {
      "fr": {
        "nom": "Tenez-vous bien !",
        "resume": "Le chef peut gifler un homme de main qui rate son test d'animosité : la Force de la gifle s'ajoute au jet d'animosité."
      },
      "en": {
        "nom": "Oi Behave!",
        "resume": "The Boss may slap a henchman who fails Animosity, adding the slap's Strength to the Animosity roll."
      }
    },
    "Black Orc Blood": {
      "fr": {
        "nom": "Sang d'Orque noir",
        "resume": "Un seul Jeunot peut devenir un Jeunot orque noir pour 10 co, ce qui lui ouvre la compétence « Guerrier aguerri »."
      },
      "en": {
        "nom": "Black Orc Blood",
        "resume": "One Young'un may be upgraded to a Black Orc Young'un for 10 gc, which lets him take the Proven Warrior skill."
      }
    },
    "Unstable": {
      "fr": {
        "nom": "Instables",
        "resume": "Les Cinglés ne sont pas soumis à l'animosité."
      },
      "en": {
        "nom": "Unstable",
        "resume": "Nuttaz do not suffer from Animosity."
      }
    },
    "Crazy": {
      "fr": {
        "nom": "Fêlés",
        "resume": "Ils réussissent automatiquement tous les tests basés sur le Commandement, mais ne peuvent jamais apprendre de compétences d'Érudition."
      },
      "en": {
        "nom": "Crazy",
        "resume": "They automatically pass all Leadership-based tests but can never learn Academic skills."
      }
    },
    "Savage": {
      "fr": {
        "nom": "Sauvages",
        "resume": "Ils doivent courir ou charger vers l'ennemi visible le plus proche et ont une attaque supplémentaire au corps à corps ; ils ne portent ni armure ni arme de tir et ne peuvent ni mener la bande ni prêter leur Cd pour la déroute."
      },
      "en": {
        "nom": "Savage",
        "resume": "They must run or charge toward the nearest visible enemy and get an extra close-combat attack; they use no armour or missile weapons and can neither lead nor lend their Ld for Rout tests."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Orques noirs)",
    "listeEn": "Special Skills (Black Orcs)",
    "competences": [
      {
        "en": "Proven Warrior",
        "nom": "Guerrier aguerri",
        "resume": "Un Jeunot au sang d'Orque noir ayant 25 points d'expérience devient un Orque noir à part entière (règles, équipement, compétences) tout en gardant son titre.",
        "resumeEn": "A Young'un with Black Orc Blood and 25 experience becomes a full Black Orc (rules, equipment, skills) while keeping his title.",
        "condition": "orques-noirs/youngun"
      },
      {
        "en": "'Ard 'ead",
        "nom": "Tête dure",
        "resume": "Sauvegarde de 3+ contre l'étourdissement (2+ avec un casque) : un résultat sonné réussi devient « à terre ».",
        "resumeEn": "3+ save against being stunned (2+ with a helmet): a saved stun becomes knocked down.",
        "condition": null
      },
      {
        "en": "Waaagh!",
        "nom": "Waaagh !",
        "resume": "Ajoute D3 ps à sa distance de charge.",
        "resumeEn": "Adds D3\" to his charge range.",
