 "reglesTexte": {
  "Mercenary Hired Swords": {
   "fr": {
    "nom": "Francs-tireurs mercenaires",
    "resume": "La bande peut engager les mêmes francs-tireurs qu'une bande de mercenaires."
   },
   "en": {
    "nom": "Mercenary Hired Swords",
    "resume": "The warband may hire the same Hired Swords as a Mercenary warband."
   }
  },
  "Horse and Rider": {
   "fr": {
    "nom": "Cheval et cavalier",
    "resume": "À leur recrutement, le Parangon et le Galant peuvent chacun acheter un cheval ou un cheval de guerre à moitié prix."
   },
   "en": {
    "nom": "Horse and Rider",
    "resume": "When recruited, the Paragon and the Gallant may each buy a horse or warhorse at half price."
   }
  },
  "Vow of Poverty": {
   "fr": {
    "nom": "Vœu de pauvreté",
    "resume": "Le Parangon ne peut jamais utiliser de lance de cavalerie."
   },
   "en": {
    "nom": "Vow of Poverty",
    "resume": "The Paragon may never use a lance."
   }
  },
  "Ancient Armour": {
   "fr": {
    "nom": "Armure ancienne",
    "resume": "Elle porte une armure inamovible (ni échangée ni volée) qui ne gêne pas les prières et donne une sauvegarde de 5+ non modifiable, sans effet contre les attaques magiques."
   },
   "en": {
    "nom": "Ancient Armour",
    "resume": "She wears armour that cannot be removed, traded or stolen; it does not hinder prayers and gives an unmodifiable 5+ save that does not work against magical attacks."
   }
  },
  "Prayers of the Mare": {
   "fr": {
    "nom": "Prières de la Jument",
    "resume": "Elle utilise la liste des Bénédictions de la Jument et commence avec une prière tirée au hasard."
   },
   "en": {
    "nom": "Prayers of the Mare",
    "resume": "She uses the Blessings of the Mare list and starts with one random prayer."
   }
  },
  "Peasants": {
   "fr": {
    "nom": "Paysans",
    "resume": "Les pèlerins ne peuvent jamais devenir des héros : relancez le résultat « Le gars a du talent »."
   },
   "en": {
    "nom": "Peasants",
    "resume": "Pilgrims can never become heroes; re-roll any 'The Lad's Got Talent' result."
   }
  },
  "Hooves": {
   "fr": {
    "nom": "Sabots",
    "resume": "La pouliche combat sans arme sans subir de pénalité."
   },
   "en": {
    "nom": "Hooves",
    "resume": "The filly fights unarmed without penalty."
   }
  },
  "Spectral Covering": {
   "fr": {
    "nom": "Caparaçon spectral",
    "resume": "Sauvegarde de 5+ non modifiable, sans effet contre la magie ; la pouliche ne peut prendre aucun autre équipement."
   },
   "en": {
    "nom": "Spectral Covering",
    "resume": "Unmodifiable 5+ save that does not work against magic; the filly may take no other equipment."
   }
  }
 },
 "competencesSpeciales": null,
 "races": {},
 "notes": "Pas de liste de compétences spéciales sur la page. « Knights only » (lance de cavalerie, armure lourde, barde, cheval de guerre) attribué au Parangon, au Galant et aux Chevaliers rachetés (porteurs de Vertu chevaleresque) ; le Parangon n'a pas la lance de cavalerie (Vœu de pauvreté). Lance et hallebarde de la liste Fantassin réservées aux Pèlerins, ainsi que l'arc ; lance de la liste Archer et cheval réservés aux Écuyères. Cheval / cheval de guerre à moitié prix pour Parangon et Galant au recrutement (prix plein saisi). Hatred des Pèlerins : envers tous les ennemis qui défient la Dame. La pouliche suit les règles de mouvement des montures ; race inconnue (null). La Dame doit être remplacée immédiatement si elle disparaît (aucun autre recrutement avant). Bénédictions de la Jument (2D6) : Regard troublant 7, Sabot fantôme 9, Inspiration de la Dame 7, Soif de bravoure 8, Aura d'intrépidité 10, Destrier de la Dame 8 (destrier spectral M8 CC4 CT0 F4 E4 PV1 I4 A2 Cd7, cause la peur). Option Blazing Saddles : Parangon, Galant, Écuyères et Chevaliers rachetés gagnent la compétence Monte. Effectif minimum 3."
}