 "reglesTexte": {
  "Riding (horse)": {
   "fr": {
    "nom": "Équitation (cheval)",
    "resume": "Possède la compétence d'équitation et peut monter un cheval."
   },
   "en": {
    "nom": "Riding (horse)",
    "resume": "Has the Riding (horses) skill and may ride a horse."
   }
  },
  "Commands": {
   "fr": {
    "nom": "Ordres",
    "resume": "Connaît un Ordre au départ et en apprend d'autres comme des sorts ; lancés en phase de ralliement au lieu de courir, ils affectent les alliés à 6 ps qui l'entendent (pas les animaux, alliés ni francs-tireurs). Ce ne sont pas des sorts."
   },
   "en": {
    "nom": "Commands",
    "resume": "Knows one Command and learns more like spells; issued in the Recovery phase instead of running, they affect friends within 6\" who can hear him (not animals, allies or Hired Swords). They are not spells."
   }
  },
  "Corruption": {
   "fr": {
    "nom": "Corruption",
    "resume": "Au corps à corps, avant les jets pour blesser, on peut payer 5 co par figurine ennemie qui a touché pour lui faire relancer une touche réussie ; une fois par figurine, sans effet sur les figurines insensibles à la psychologie."
   },
   "en": {
    "nom": "Corruption",
    "resume": "In close combat, before wound rolls, pay 5 gc per hitting enemy to make it reroll one successful hit; once per model, not on models immune to psychology."
   }
  },
  "Haggle": {
   "fr": {
    "nom": "Marchandage",
    "resume": "Possède la compétence Marchandage."
   },
   "en": {
    "nom": "Haggle",
    "resume": "Has the Haggle skill."
   }
  },
  "Indolent": {
   "fr": {
    "nom": "Indolent",
    "resume": "Ne peut pas être visé par les Ordres du Chevalier errant."
   },
   "en": {
    "nom": "Indolent",
    "resume": "Cannot be targeted by the Wandering Knight's Commands."
   }
  },
  "Ye give way": {
   "fr": {
    "nom": "Cède-moi le passage !",
    "resume": "En chargeant un héros, peut lancer un défi : refusé, la charge ne vise plus ce héros et celui-ci subit -1 pour toucher toute la partie ; accepté, seuls les deux combattent, et le vainqueur gagne +1 pour toucher et +1 F pour la partie."
   },
   "en": {
    "nom": "Ye give way",
    "resume": "When charging a Hero he may issue a challenge: if refused the refuser suffers -1 to hit for the game; if accepted only the two fight and taking out the foe grants +1 to hit and +1 S for the game."
   }
  },
  "Petty thief": {
   "fr": {
    "nom": "Chapardeur",
    "resume": "S'il n'a pas été mis hors de combat, sur 5+ au D6 après la partie, il vole un fragment de malepierre à une bande adverse au hasard."
   },
   "en": {
    "nom": "Petty thief",
    "resume": "If not taken out of action, on a 5+ after the game he steals a wyrdstone shard from a random opposing warband."
   }
  },
  "Butcher's meat": {
   "fr": {
    "nom": "Viande de boucherie",
    "resume": "Les ennemis l'ignorent pour déterminer la cible la plus proche au tir ; les Mazzalupo engagés seulement contre des moutons peuvent tirer, la cible touchée étant tirée au hasard."
   },
   "en": {
    "nom": "Butcher's meat",
    "resume": "Enemies ignore it when picking the closest target; Mazzalupo models engaged only with Black Sheep may shoot, the hit model being chosen randomly."
   }
  },
  "Mountain animals": {
   "fr": {
    "nom": "Animaux de montagne",
    "resume": "Escalade normalement, comme un humain."
   },
   "en": {
    "nom": "Mountain animals",
    "resume": "Climbs normally."
   }
  }
 },
 "competencesSpeciales": null,
 "races": {},
 "notes": "Effectif : 3 à 15. Recrute les mêmes francs-tireurs et personnages que les bandes de mercenaires (non saisi). Pas de liste de compétences spéciales. Le Chevalier errant connaît un Ordre au départ (6 ordres : « Levez notre bannière ! », « Bouge, mécréant ! », « Suivez-moi, mes bagarreurs ! », « En garde, mes braves ! », « Ignorez-les ! », « Es-tu prêt à mourir en combattant ? », difficulté 6 à 8) et en apprend d'autres comme des sorts ; ce n'est pas un sorcier. Le Cheval (40 co) : les Nobles déchus ne peuvent être montés que si le chef l'est. Armure lourde, Rondache, Hallebarde, Lance de cavalerie et Arc sont réservés aux héros (présents seulement dans les listes de héros). La Cape en peau d'ours (10 co, +1 en sauvegarde contre les tirs) n'est accessible qu'aux Bergers : test D6 ≤ Force, sans test à la création ; elle n'est donc pas mise dans la liste des Rustres. Le Maître des finances et l'Écuyer ont des listes séparées mais identiques sur la page. Le Mouton noir n'est pas stupide si un Berger est à 6 ps."
}