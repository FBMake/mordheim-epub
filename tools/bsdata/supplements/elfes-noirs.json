  "reglesTexte": {
    "Kindred Hatred": {
      "fr": {
        "nom": "Haine fratricide",
        "resume": "Les guerriers de la bande haïssent tous les Hauts Elfes, y compris les Hauts Elfes recrutés comme francs-tireurs."
      },
      "en": {
        "nom": "Kindred Hatred",
        "resume": "The warband hates every High Elf model, High Elf Hired Swords included."
      }
    },
    "Excellent Sight": {
      "fr": {
        "nom": "Vue perçante",
        "resume": "Les elfes repèrent les ennemis cachés à une distance égale au double de leur Initiative en pas."
      },
      "en": {
        "nom": "Excellent Sight",
        "resume": "Elves detect Hidden enemies at twice their Initiative in inches."
      }
    },
    "Black Powder Weapons": {
      "fr": {
        "nom": "Armes à poudre",
        "resume": "La bande ne peut jamais utiliser d'armes à poudre noire."
      },
      "en": {
        "nom": "Black Powder Weapons",
        "resume": "The warband may never use black powder weapons."
      }
    },
    "Cold One Beasthound": {
      "fr": {
        "nom": "Chiens de Sang-froid",
        "resume": "Le maître des bêtes peut être accompagné de deux Chiens de Sang-froid au plus, achetés comme hommes de main."
      },
      "en": {
        "nom": "Cold One Beasthound",
        "resume": "The Beastmaster may be accompanied by up to two Cold One Beasthounds, bought as henchmen."
      }
    },
    "Melee Specialists": {
      "fr": {
        "nom": "Spécialistes du corps à corps",
        "resume": "Ces guerriers ne peuvent utiliser aucune arme de tir."
      },
      "en": {
        "nom": "Melee Specialists",
        "resume": "These warriors may not use any missile weapon."
      }
    },
    "Wizard (Dark Elf Magic)": {
      "fr": {
        "nom": "Sorcier (Magie elfe noire)",
        "resume": "La sorcière lance des sorts de la Magie elfe noire et ne peut pas lancer de sort si elle porte une armure."
      },
      "en": {
        "nom": "Wizard (Dark Elf Magic)",
        "resume": "The Sorceress casts Dark Elf Magic spells and cannot cast while wearing armour."
      }
    },
    "Natural Stealth": {
      "fr": {
        "nom": "Discrétion naturelle",
        "resume": "Un ennemi qui tente de repérer un elfe noir caché subit -1 à son Initiative."
      },
      "en": {
        "nom": "Natural Stealth",
        "resume": "Enemies trying to spot a Hidden Dark Elf suffer -1 to their Initiative."
      }
    },
    "Beastmaster": {
      "fr": {
        "nom": "Lien avec le maître",
        "resume": "Si le maître des bêtes meurt, les chiens s'enfuient et sont retirés de la liste ; ils ne combattent pas si le maître ne peut pas participer. Ils ne gagnent jamais d'expérience."
      },
      "en": {
        "nom": "Beastmaster",
        "resume": "If the Beastmaster dies the hounds run off and are removed; they cannot fight when he cannot. They never gain experience."
      }
    },
    "Scaly Skin": {
      "fr": {
        "nom": "Peau écailleuse",
        "resume": "Sauvegarde naturelle de 6+, que les modificateurs de Force ne peuvent pas dégrader au-delà de 6 ; annulée par un coup critique « sans sauvegarde »."
      },
      "en": {
        "nom": "Scaly Skin",
        "resume": "Natural 6+ armour save, never worse than 6 from Strength modifiers; negated by a 'no save' critical hit."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Elfes Noirs)",
    "listeEn": "Special Skills (Dark Elves)",
    "competences": [
      {
        "en": "Fury of Khaine",
        "nom": "Furie de Khaine",
        "resume": "Après avoir mis hors de combat tous ses adversaires, le héros peut faire un mouvement de poursuite de 4 ps ; s'il atteint un ennemi, il compte comme chargeant au tour suivant. Pas pendant le tour adverse.",
        "resumeEn": "After taking all opponents out of action, the hero may make a 4\" follow-up move; contacting a new enemy counts as a charge next turn. Not in the opponent's turn.",
        "condition": null
      },
      {
        "en": "Powerful Build",
        "nom": "Carrure puissante",
        "resume": "Donne accès aux compétences de Force. Interdite à la sorcière ; deux guerriers au plus de la bande peuvent la posséder.",
        "resumeEn": "Grants access to Strength skills. Not for the Sorceress; at most two warriors in the warband may have it.",
        "condition": null
      },
      {
        "en": "Fey Quickness",
        "nom": "Vivacité féerique",
        "resume": "Le héros évite les attaques de corps à corps ou de tir sur 6 ; sur 4+ dans le domaine concerné s'il a aussi Esquive latérale ou Esquive.",
        "resumeEn": "The hero avoids melee or missile hits on a 6; on 4+ in the relevant area if he also has Step Aside or Dodge.",
        "condition": null
      },
      {
        "en": "Infiltration",
        "nom": "Infiltration",
        "resume": "Le héros se déploie après l'adversaire, hors de sa vue et à plus de 12 ps de tout ennemi. Si les deux camps infiltrent, le plus bas sur 1D6 se place en premier.",
        "resumeEn": "The hero deploys after the enemy, out of sight and over 12\" from enemies. If both sides infiltrate, lowest D6 sets up first.",
        "condition": null
      },
      {
        "en": "Master of Poisons",
        "nom": "Maître des poisons",
        "resume": "Au lieu de chercher un objet rare, le héros fabrique 1D3-1 doses de Venin noir, à utiliser à la bataille suivante ; elles ne peuvent être ni vendues ni échangées.",
        "resumeEn": "Instead of searching for a rare item, the hero brews D3-1 doses of Dark Venom for the next battle; they cannot be sold or traded.",
        "condition": null
      }
    ]
  },
