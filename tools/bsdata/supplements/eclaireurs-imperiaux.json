  "reglesTexte": {
    "Mounted Warband": {
      "fr": {
        "nom": "Bande montée",
        "resume": "Chaque guerrier possède un cheval de selle compris dans son coût ; une figurine sans monture ne peut pas jouer. La bande ignore la limite habituelle de deux montures en terrain dense et ne peut engager que des francs-tireurs montés (Chevalier franc, Garde des routes ; jamais de Bandit de grand chemin). Un cheval mort doit être remplacé avant toute autre dépense."
      },
      "en": {
        "nom": "Mounted Warband",
        "resume": "Every warrior comes with a riding horse included in his cost and a model without a mount may not fight. The warband ignores the usual two-mount limit in dense terrain and may only hire mounted Hired Swords (Freelance Knight, Roadwarden; never the Highwayman). Dead horses must be replaced before any other spending."
      }
    },
    "Ride": {
      "fr": {
        "nom": "Monte",
        "resume": "Le guerrier sait monter à cheval et combattre en selle (règles de cavalerie de Blazing Saddles)."
      },
      "en": {
        "nom": "Ride",
        "resume": "The warrior can ride and fight mounted (Blazing Saddles cavalry rules)."
      }
    },
    "Combat Riding": {
      "fr": {
        "nom": "Combat monté",
        "resume": "Quand il charge un adversaire non monté, le cavalier gagne une attaque supplémentaire de Force 4 portée par sa monture."
      },
      "en": {
        "nom": "Combat Riding",
        "resume": "When charging an unmounted enemy the rider gets one extra Strength 4 attack from his mount."
      }
    },
    "Animal Handling": {
      "fr": {
        "nom": "Soin des chevaux",
        "resume": "Le palefrenier a la compétence Dressage d'animaux de Blazing Saddles : il sait calmer et maîtriser les chevaux."
      },
      "en": {
        "nom": "Animal Handling",
        "resume": "The groom has the Blazing Saddles Animal Handling skill and knows how to calm and control horses."
      }
    }
  },
