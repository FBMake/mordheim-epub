  "reglesTexte": {
    "Tribes": {
      "fr": {
        "nom": "Tribus",
        "resume": "À la création, la bande choisit sa tribu : Norses (bonus aux recherches d'objets rares), Kurgans (chiens illimités, arcs en os, malus aux objets rares) ou Hungs (12 guerriers max., chevaux à 40 co et Cavalier pour tous les héros)."
      },
      "en": {
        "nom": "Tribes",
        "resume": "At creation the warband picks a tribe: Norse (bonus to rare item searches), Kurgan (unlimited hounds, bone bows, rare item penalty) or Hung (max 12 warriors, 40 gc warhorses, all Heroes may ride)."
      }
    },
    "Eye of the Gods": {
      "fr": {
        "nom": "Œil des dieux",
        "resume": "Après chaque bataille où le chef a combattu, lancez 2D6 pour voir s'il gagne une Marque du Chaos ou devient un rejeton ; le test cesse une fois la Marque obtenue."
      },
      "en": {
        "nom": "Eye of the Gods",
        "resume": "After each battle the leader fought in, roll 2D6 to see whether he earns a Mark of Chaos or becomes a Spawn; the test stops once he has a Mark."
      }
    },
    "Spawn of Chaos": {
      "fr": {
        "nom": "Déchéance",
        "resume": "Après une défaite, +1 au jet par héros mis hors de combat ; sur 12+, le chef devient un rejeton du Chaos et perd tout (ou quitte la bande si un rejeton existe déjà)."
      },
      "en": {
        "nom": "Spawn of Chaos",
        "resume": "After a defeat, +1 per Hero taken out of action; on 12+ the leader becomes a Chaos Spawn and loses everything (or leaves if a Spawn already exists)."
      }
    },
    "Mark of Chaos": {
      "fr": {
        "nom": "Marque du Chaos",
        "resume": "Après une victoire, +1 au jet par ennemi mis hors de combat par le chef ; sur 12+, il peut choisir une Marque du Chaos."
      },
      "en": {
        "nom": "Mark of Chaos",
        "resume": "After a victory, +1 per enemy the leader took out of action; on 12+ he may choose a Mark of Chaos."
      }
    },
    "Marks of the Dark Gods": {
      "fr": {
        "nom": "Marques des dieux sombres",
        "resume": "Chaque Marque (Chaos universel, Tchar, Arkhar, Onogal, Shornaal) donne un effet différent au chef et au voyant ; hors Chaos universel, la bande ne peut mêler deux Marques différentes."
      },
      "en": {
        "nom": "Marks of the Dark Gods",
        "resume": "Each Mark (Undivided, Tchar, Arkhar, Onogal, Shornaal) gives the leader and the Seer a different effect; apart from Undivided, no two different Marks may be mixed."
      }
    },
    "Wizard (Marks of Chaos)": {
      "fr": {
        "nom": "Sorcier (Marques du Chaos)",
        "resume": "Le voyant est un sorcier ; il choisit une Marque au recrutement, qui fixe ses sorts (Rituels du Chaos, de Tchar, d'Onogal, de Shornaal) ou en fait un Père de sang sans sorts (Arkhar)."
      },
      "en": {
        "nom": "Wizard (Marks of Chaos)",
        "resume": "The Seer is a wizard; he picks a Mark when hired, which sets his spells (Chaos, Tchar, Onogal or Shornaal Rituals) or makes him a spell-less Bloodfather (Arkhar)."
      }
    },
    "Inconsistency": {
      "fr": {
        "nom": "Instabilité",
        "resume": "CC, F, E et A sont relancés à chaque tour."
      },
      "en": {
        "nom": "Inconsistency",
        "resume": "WS, S, T and A are re-rolled every turn."
      }
    },
    "Condemned Experience": {
      "fr": {
        "nom": "Expérience du condamné",
        "resume": "Au lieu de progresser normalement, il lance des dés pour ses caractéristiques et peut en fixer les résultats."
      },
      "en": {
        "nom": "Condemned Experience",
        "resume": "Instead of normal advances he rolls dice for his characteristics and may fix the results."
      }
    },
    "Fate": {
      "fr": {
        "nom": "Destin",
        "resume": "À 90 points d'expérience, s'il lui reste des caractéristiques non fixées, il devient un rejeton du Chaos (ou s'en va s'il y en a déjà un)."
      },
      "en": {
        "nom": "Fate",
        "resume": "At 90 experience with unfixed characteristics he becomes a Chaos Spawn (or wanders off if one exists)."
      }
    },
    "Spawn Attacks": {
      "fr": {
        "nom": "Attaques du rejeton",
        "resume": "Le nombre d'attaques (D6+1) est tiré à chaque phase de corps à corps."
      },
      "en": {
        "nom": "Spawn Attacks",
        "resume": "Its number of attacks (D6+1) is rolled in each close combat phase."
      }
    },
    "Spawn Movement": {
      "fr": {
        "nom": "Mouvement du rejeton",
        "resume": "Se déplace de 2D6 ps en ligne droite."
      },
      "en": {
        "nom": "Spawn Movement",
        "resume": "Moves 2D6\" in a straight line."
      }
    },
    "Spawn Psychology": {
      "fr": {
        "nom": "Psychologie du rejeton",
        "resume": "Réussit automatiquement tous ses tests de Commandement."
      },
      "en": {
        "nom": "Spawn Psychology",
        "resume": "Automatically passes all Leadership tests."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Maraudeurs du Chaos)",
    "listeEn": "Special Skills (Marauders of Chaos)",
    "competences": [
      {
        "en": "Chosen of Chaos",
        "nom": "Élu du Chaos",
        "resume": "Le héros devient un guerrier du Chaos : il utilise les maximums des guerriers du Chaos et la liste d'équipement des héros.",
        "resumeEn": "The Hero becomes a Chaos Warrior, using the Warriors of Chaos maximums and the Hero equipment list.",
        "condition": null
      },
      {
        "en": "Tattooed Body",
        "nom": "Corps tatoué",
        "resume": "L'Œil des dieux se déclenche sur 10+ au lieu de 12+ (11+ pour un chef norse).",
        "resumeEn": "Eye of the Gods triggers on 10+ instead of 12+ (11+ for a Norse leader).",
        "condition": "chef"
      },
      {
        "en": "Sweeping Blow",
        "nom": "Coup circulaire",
        "resume": "Avec une arme lourde, après avoir mis un ennemi hors de combat, fait une attaque supplémentaire contre une autre figurine au contact ; nécessite Costaud.",
        "resumeEn": "With a double-handed weapon, after taking an enemy out of action, makes an extra attack on another model in contact; requires Strongman.",
        "condition": null
      },
      {
        "en": "Mutant",
        "nom": "Mutant",
        "resume": "Achète une mutation (liste des Possédés) ; un héros marqué d'Onogal peut prendre une Bénédiction de Nurgle. Peut être pris plusieurs fois.",
        "resumeEn": "Buys one mutation (Possessed list); a Hero with the Mark of Onogal may take a Nurgle Blessing instead. May be taken several times.",
        "condition": null
      },
      {
        "en": "Heart of the Warrior",
        "nom": "Cœur du guerrier",
        "resume": "Relance les tests de déroute ratés et est immunisé à la peur et aux tests de combat seul.",
        "resumeEn": "Re-rolls failed Rout tests and is immune to fear and All Alone tests.",
        "condition": "chef"
      }
    ]
  },
  "races": {
    "maraudeurChaos": {
      "nom": "Maraudeur du Chaos",
      "max": {
        "M": 4,
