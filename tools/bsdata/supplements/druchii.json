  "reglesTexte": {
    "Fey Acuity": {
      "fr": {
        "nom": "Acuité féerique",
        "resume": "Si au moins un héros a exploré, la bande trouve un artefact ou un fragment de malepierre de plus lors de la phase d'exploration."
      },
      "en": {
        "nom": "Fey Acuity",
        "resume": "If at least one hero searched, the warband finds one extra artifact or Wyrdstone shard in the Exploration phase."
      }
    },
    "Disdain": {
      "fr": {
        "nom": "Dédain",
        "resume": "Les Druchii ne peuvent jamais utiliser d'armes à poudre noire."
      },
      "en": {
        "nom": "Disdain",
        "resume": "Druchii may never use black powder weapons."
      }
    },
    "Slavers (Druchii)": {
      "fr": {
        "nom": "Esclavagistes druchii",
        "resume": "Sur un résultat « prisonnier » (333) en exploration, la bande peut appliquer les règles de prisonniers des Skavens."
      },
      "en": {
        "nom": "Slavers (Druchii)",
        "resume": "On a prisoner result (333) in Exploration, the warband may use the Skaven prisoner rules."
      }
    },
    "Wizard (Dark Magic)": {
      "fr": {
        "nom": "Sorcier (Magie noire)",
        "resume": "La sorcière lance des sorts de Magie noire druchii (Éclair funeste, Mot de douleur, Voleur d'âme, Lame noire de Khaine, Spasme mortel, Vol de sorcière) ; elle ne peut pas lancer de sorts si elle porte une armure."
      },
      "en": {
        "nom": "Wizard (Dark Magic)",
        "resume": "The Sorceress casts Druchii Dark Magic (Doombolt, Word of Pain, Soul Stealer, Black Blade of Khaine, Deathspasm, Witch Flight); she cannot cast while wearing armour."
      }
    },
    "Natural Stealth (Shades)": {
      "fr": {
        "nom": "Discrétion naturelle (Ombres)",
        "resume": "Quand une ombre est cachée, l'ennemi n'utilise que la moitié de son Initiative pour la repérer."
      },
      "en": {
        "nom": "Natural Stealth (Shades)",
        "resume": "When a Shade is Hidden, enemies use half their Initiative to detect it."
      }
    },
    "Maiden Poison": {
      "fr": {
        "nom": "Poison des vierges",
        "resume": "La bande peut acheter du lotus noir à 5 co la dose, réservé aux elfes sorcières ; il doit servir à la bataille suivante et ne peut être ni vendu ni échangé."
      },
      "en": {
        "nom": "Maiden Poison",
        "resume": "The warband may buy Black Lotus at 5 gc per dose for Witch Elves only; it must be used next battle and cannot be sold or traded."
      }
    },
    "Pack Work": {
      "fr": {
        "nom": "Travail de meute",
        "resume": "Les chiens utilisent le Commandement du maître des bêtes à 6 ps et ne combattent pas sans lui. Si un chien connaît la position d'un ennemi, le maître et les autres chiens peuvent le charger sans le voir."
      },
      "en": {
        "nom": "Pack Work",
        "resume": "Slavehounds use the Beastmaster's Leadership within 6\" and stay in camp without him. If one knows of an enemy, the Beastmaster and other hounds may charge it unseen."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Druchii)",
    "listeEn": "Special Skills (Druchii)",
    "competences": [
      {
        "en": "Frenzied Charge",
        "nom": "Charge frénétique",
        "resume": "Après avoir mis hors de combat tous ses adversaires, le héros fait un mouvement de poursuite de 4 ps ; s'il touche un ennemi, il compte comme chargeant au tour suivant.",
        "resumeEn": "After taking all opponents out of action, make a 4\" follow-up move; contacting an enemy counts as a charge next turn.",
        "condition": null
      },
      {
        "en": "Fey Quickness",
        "nom": "Vivacité féerique",
        "resume": "Évite une attaque de corps à corps ou de tir sur 6 ; sur 4+ dans le domaine concerné s'il possède Esquive latérale ou Esquive.",
        "resumeEn": "Avoids close combat or missile attacks on a 6, improved to 4+ in the relevant area with Step Aside or Dodge.",
        "condition": null
      },
      {
        "en": "Infiltration",
        "nom": "Infiltration",
        "resume": "Le héros peut s'infiltrer comme avec la compétence skaven du même nom.",
        "resumeEn": "The hero may Infiltrate, as the Skaven skill.",
        "condition": null
      },
      {
        "en": "Poisoner",
