 "reglesTexte": {
  "Wizard (Chaos Dwarf Magic)": {
   "fr": {
    "nom": "Sorcier (Magie des Nains du Chaos)",
    "resume": "L'apprenti sorcier est un sorcier qui connaît un sort tiré au hasard dans la liste des Nains du Chaos ; il ne peut pas lancer de sorts s'il porte une armure."
   },
   "en": {
    "nom": "Wizard (Chaos Dwarf Magic)",
    "resume": "The Apprentice Sorcerer is a wizard who knows one random spell from the Chaos Dwarf list; he cannot cast spells while wearing armour."
   }
  },
  "Slavers": {
   "fr": {
    "nom": "Esclavagistes",
    "resume": "Les esclaves capturés ne sont jamais libérés : chacun est sacrifié (+1 XP à l'apprenti sorcier) ou mis au travail (+1 fragment de malepierre après la partie, puis sur 1 au D6 l'esclave s'évade avec son équipement, sinon il meurt et la bande garde son équipement)."
   },
   "en": {
    "nom": "Slavers",
    "resume": "Captives are never freed: each is sacrificed (+1 XP for the Apprentice Sorcerer) or put to work (+1 wyrdstone after the game, then on a D6 roll of 1 the slave escapes with his gear, otherwise he dies and the warband keeps his gear)."
   }
  },
  "Uncommon": {
   "fr": {
    "nom": "Peu nombreux",
    "resume": "Recruter de nouveaux nains du Chaos coûte 1,5 fois l'expérience normale (arrondi au supérieur) ; ne s'applique pas aux hobgobelins."
   },
   "en": {
    "nom": "Uncommon",
    "resume": "Recruiting new members costs 1.5 times the normal experience (rounded up); this does not apply to Hobgoblins."
   }
  },
  "Indentured Servants": {
   "fr": {
    "nom": "Serviteurs asservis",
    "resume": "La bande doit compter au moins 4 hobgobelins ; si elle passe en dessous, elle ne peut recruter personne d'autre tant qu'elle n'en a pas de nouveau 4."
   },
   "en": {
    "nom": "Indentured Servants",
    "resume": "The warband must include at least 4 Hobgoblins; if it falls below 4, no one else may be recruited until it is back to 4."
   }
  },
  "Skinny": {
   "fr": {
    "nom": "Maigrelet",
    "resume": "Sur un résultat de 1 à 3 au jet de blessure grave, le hobgobelin abandonne la bande."
   },
   "en": {
    "nom": "Skinny",
    "resume": "On a Serious Injury roll of 1-3, the Hobgoblin deserts the warband."
   }
  },
  "Nobody Cares About Them": {
   "fr": {
    "nom": "Tout le monde s'en fiche",
    "resume": "Un hobgobelin compte pour une demi-figurine pour les tests de déroute et ne peut jamais devenir un héros."
   },
   "en": {
    "nom": "Nobody Cares About Them",
    "resume": "A Hobgoblin counts as half a model for Rout tests and can never become a Hero."
   }
  }
 },
 "competencesSpeciales": {
  "liste": "Spéciales (Nains du Chaos)",
  "listeEn": "Special Skills (Chaos Dwarfs)",
  "competences": [
   {
    "en": "True Grit",
    "nom": "Cran véritable",
    "resume": "Ses jets de blessure donnent : 1-3 à terre, 4-5 sonné, 6 hors de combat.",
    "resumeEn": "His injury rolls are: 1-3 knocked down, 4-5 stunned, 6 out of action.",
    "condition": null
   },
   {
    "en": "Extra Tough",
    "nom": "Extrêmement résistant",
    "resume": "Il peut relancer son jet de blessure grave après la partie et doit garder le second résultat.",
    "resumeEn": "He may re-roll his post-game Serious Injury roll, keeping the second result.",
    "condition": null
   },
   {
    "en": "Unlimited Hatred",
    "nom": "Haine sans limite",
    "resume": "Il hait tous ses ennemis.",
    "resumeEn": "He hates all enemies.",
    "condition": null
   },
   {
    "en": "Thick Skull",
    "nom": "Crâne épais",
    "resume": "Il a une sauvegarde de 3+ contre « sonné » (2+ avec un casque, au lieu de la règle normale du casque) ; réussie, il est seulement à terre.",
    "resumeEn": "He has a 3+ save against being stunned (2+ with a helmet, replacing the normal helmet rule); if passed he is knocked down instead.",
    "condition": null
   }
  ]
 },
