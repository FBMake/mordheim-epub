  "reglesTexte": {
    "Natives": {
      "fr": {
        "nom": "Natifs",
        "resume": "Le guerrier ignore les pénalités de mouvement en terrain boisé."
      },
      "en": {
        "nom": "Natives",
        "resume": "The warrior ignores movement penalties in wooded terrain."
      }
    },
    "Ride Spiders": {
      "fr": {
        "nom": "Chevaucheur d'araignées",
        "resume": "Le chef peut monter les araignées géantes et l'araignée gigantesque (règles optionnelles de monture)."
      },
      "en": {
        "nom": "Ride Spiders",
        "resume": "The Chieftain may ride Giant Spiders and the Gigantic Spider (optional mount rules)."
      }
    },
    "Wizard (Forest Goblin Magic)": {
      "fr": {
        "nom": "Sorcier (Magie des gobelins de la forêt)",
        "resume": "Le chaman est un sorcier : il commence avec un sort tiré au hasard dans la liste des gobelins de la forêt."
      },
      "en": {
        "nom": "Wizard (Forest Goblin Magic)",
        "resume": "The Shaman is a wizard who starts with one random spell from the Forest Goblin spell list."
      }
    },
    "Berserkers": {
      "fr": {
        "nom": "Berserks",
        "resume": "Ces gobelins sont sujets à la frénésie ; s'ils commencent leur tour à portée de charge d'un ennemi, ils ignorent l'animosité ce tour-là."
      },
      "en": {
        "nom": "Berserkers",
        "resume": "These goblins are subject to frenzy; if they start their turn within charge range of an enemy they ignore animosity that turn."
      }
    },
    "Sluggas": {
      "fr": {
        "nom": "Sluggas",
        "resume": "Lors de la phase de tir, le slugga peut lancer ses armes de jet jusqu'à trois fois ; non cumulable avec Tir rapide s'il est promu."
      },
      "en": {
        "nom": "Sluggas",
        "resume": "In the shooting phase a Slugga may throw its thrown weapons up to three times; cannot be combined with Quick Shot if promoted."
      }
    },
    "Poisonous": {
      "fr": {
        "nom": "Venimeuse",
        "resume": "Après une blessure, le jet de blessure donne : 1 à terre, 2-4 sonné, 5-6 hors de combat."
      },
      "en": {
        "nom": "Poisonous",
        "resume": "When it wounds, the injury roll is 1 knocked down, 2-4 stunned, 5-6 out of action."
      }
    },
    "Non-sentient": {
      "fr": {
        "nom": "Créature sans conscience",
        "resume": "L'araignée est sujette à la stupidité, peut escalader et ne gagne jamais d'expérience."
      },
      "en": {
        "nom": "Non-sentient",
        "resume": "The spider is subject to stupidity, may climb, and never gains experience."
      }
    },
    "May Ride": {
      "fr": {
        "nom": "Monture",
        "resume": "Le chef peut la chevaucher : il gagne +1 en sauvegarde d'armure et se déplace de 6 ps ; les tirs touchent le cavalier sur 1-2 et l'araignée sur 3-6, l'adversaire choisit sa cible au corps à corps. Montée, elle ignore la stupidité."
      },
      "en": {
        "nom": "May Ride",
        "resume": "The Chieftain may ride it: +1 armour save and moves 6\"; shots hit the rider on 1-2 and the spider on 3-6, the opponent picks the target in close combat. A ridden spider ignores stupidity."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Gobelins de la forêt)",
    "listeEn": "Special Skills (Forest Goblins)",
    "competences": [
      {
        "en": "Lose Animosity",
        "nom": "Fin de l'animosité",
        "resume": "Au lieu de choisir une compétence, le brave peut se débarrasser de la règle Animosité.",
        "resumeEn": "Instead of choosing a skill, the Brave may remove the Animosity rule.",
        "condition": "gobelins-foret/brave"
      }
    ]
  },
  "races": {},
  "notes": "Bande du supplément Nemesis Crown. Aucune ligne d'équipement n'est réservée à un guerrier ; le 'Boss Pole' (20 co) n'est pas expliqué sur la page. 'Throwing Weapons' 15 co saisi tel quel. Sarbacane : portée 8 ps, F1, empoisonnée (un 6 pour toucher blesse automatiquement, pas de critique), furtive. L'araignée gigantesque n'utilise aucun équipement ; race null. La page ne liste pas les sorts (liste 'Forest Goblin'). Les araignées géantes citées par la règle du chef n'ont pas de profil sur la page. Hommes de main par groupes de 1 à 5. La liste spéciale se limite à l'option du brave (retirer l'Animosité à la place d'une compétence)."
}