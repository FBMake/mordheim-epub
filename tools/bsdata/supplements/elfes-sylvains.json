  "reglesTexte": {
    "Sniper": {
      "fr": {
        "nom": "Tireur embusqué",
        "resume": "Le garde forestier peut tirer tout en restant caché ; après le tir, sur 5+ sur 1D6, il reste caché car personne ne repère d'où vient la flèche."
      },
      "en": {
        "nom": "Sniper",
        "resume": "May shoot while hidden; after shooting, on a 5+ on a D6 nobody spots where the arrow came from and he stays hidden."
      }
    },
    "Camouflage": {
      "fr": {
        "nom": "Camouflage",
        "resume": "Quand il est caché, chaque ennemi doit en plus réussir un test d'Initiative pour le repérer."
      },
      "en": {
        "nom": "Camouflage",
        "resume": "While hidden, each enemy must also pass an Initiative test to spot him."
      }
    },
    "Wizard (Woodland Incantations)": {
      "fr": {
        "nom": "Sorcier (Incantations sylvestres)",
        "resume": "Le mage est un lanceur de sorts et tire ses sorts dans la liste des Incantations sylvestres."
      },
      "en": {
        "nom": "Wizard (Woodland Incantations)",
        "resume": "The mage is a spellcaster using the Woodland Incantations list."
      }
    },
    "Crossfire": {
      "fr": {
        "nom": "Feux croisés",
        "resume": "Si plusieurs éclaireurs tirent sur la même cible, ils gagnent +1 au jet de blessure."
      },
      "en": {
        "nom": "Crossfire",
        "resume": "If more than one Scout shoots at the same target, they get +1 to the injury roll."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Elfes sylvains d'Athel Loren)",
    "listeEn": "Special Skills (Wood Elves of Athel Loren)",
    "competences": [
      {
        "en": "Fey",
        "nom": "Féerique",
        "resume": "Le héros bénéficie d'une sauvegarde de 4+ contre la magie hostile.",
        "resumeEn": "The hero has a 4+ save against hostile magic.",
        "condition": null
      },
      {
        "en": "Elven Luck",
        "nom": "Chance elfique",
        "resume": "Une fois par partie, le héros peut relancer un jet raté.",
        "resumeEn": "Once per game the hero may re-roll any failed roll.",
        "condition": null
      },
      {
        "en": "Excellent Sight",
        "nom": "Vue perçante",
        "resume": "Le héros repère les ennemis cachés jusqu'à deux fois son Initiative en pas (redondant avec la règle de bande).",
        "resumeEn": "The hero spots hidden enemies up to twice his Initiative in inches (redundant with the warband rule).",
        "condition": null
      },
      {
        "en": "Seeker",
        "nom": "Traqueur",
        "resume": "Le héros peut modifier un dé d'exploration de +1 ou -1. Un seul héros elfe de la bande peut avoir cette compétence.",
        "resumeEn": "The hero may modify one exploration dice by +1 or -1. Only one Elf hero in the warband may have it.",
        "condition": null
      },
      {
        "en": "Infiltration",
        "nom": "Infiltration",
        "resume": "Le héros se déploie toujours en dernier, n'importe où hors de vue de l'ennemi. Si les deux camps infiltrent, le plus bas sur 1D6 se place en premier.",
        "resumeEn": "Always deployed last, anywhere out of enemy sight. If both sides have Infiltration, lowest D6 deploys first.",
        "condition": null
      }
    ]
  },
  "races": {},
  "notes": "Les héros utilisent la « Wood Elf equipment list » : liste des héros retenue. « Ithilmar weapon : 2 x prix » (héros uniquement) traduit en dague 4, épée 20, lance 20, arme lourde 30 co ; armure en ithilmar 60 co, héros uniquement (non proposée aux éclaireurs/gardes). Hommes de main achetés par groupes de 1 à 5, nombre illimité. Règle Tolerant réutilisée (la version guerriers des ombres exclut en plus les empoisonneurs, pas celle-ci). Le texte du Leader appelle le chef « Protector of the Hunt » (coquille). Incantations sylvestres non saisies. Maximums elfes : race « elfe » existante."
}