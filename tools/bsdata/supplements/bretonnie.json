  "reglesTexte": {
    "Lady of the Lake's Blessing": {
      "fr": {
        "nom": "Bénédiction de la Dame du Lac",
        "resume": "Avant chaque partie, le chef fait un test de Commandement : s'il le réussit, chaque figurine adverse doit obtenir 4+ sur 1D6 pour pouvoir tirer avec une arme à poudre noire."
      },
      "en": {
        "nom": "Lady of the Lake's Blessing",
        "resume": "Before each game the leader takes a Leadership test; if passed, enemy models must roll 4+ on a D6 to fire any black powder weapon."
      }
    },
    "Curse on Knights": {
      "fr": {
        "nom": "Malédiction protégeant les chevaliers",
        "resume": "Une figurine ennemie qui veut tirer sur un Chevalier de la quête ou un Chevalier errant doit d'abord obtenir 4+ sur 1D6, sinon elle ne peut pas tirer."
      },
      "en": {
        "nom": "Curse on Knights",
        "resume": "An enemy model wishing to shoot at a Questing Knight or Knight Errant must first roll 4+ on a D6 or it may not shoot."
      }
    },
    "Knights Virtue": {
      "fr": {
        "nom": "Vertu chevaleresque",
        "resume": "Le chevalier ne panique jamais et ne fuit jamais un combat : il n'a pas à faire de test « Seul contre tous »."
      },
      "en": {
        "nom": "Knights Virtue",
        "resume": "The knight never panics or flees combat and never has to take an 'all alone' test."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Bretonnie)",
    "listeEn": "Bretonnian Knight Virtues",
    "competences": [
      {
        "en": "Virtue of Purity",
        "nom": "Vertu de pureté",
        "resume": "Tout sort lancé contre le chevalier est dissipé sur 4+ sur 1D6.",
        "resumeEn": "Any spell cast at the knight is dispelled on a D6 roll of 4+.",
        "condition": null
      },
      {
        "en": "Virtue of Valour",
        "nom": "Vertu de bravoure",
        "resume": "Au corps à corps contre un adversaire de Force supérieure, le chevalier relance ses jets pour toucher ratés.",
        "resumeEn": "In close combat against a model with higher Strength, the knight re-rolls failed to-hit rolls.",
        "condition": null
      },
      {
        "en": "Virtue of Discipline",
        "nom": "Vertu de discipline",
        "resume": "Une fois par partie, s'il n'est ni hors de combat, ni sonné, ni à terre, le chevalier peut relancer un test de déroute raté.",
        "resumeEn": "Once per game, if not out of action, stunned or knocked down, the knight may re-roll a failed Rout test.",
        "condition": null
      },
      {
        "en": "Virtue of Noble Disdain",
        "nom": "Vertu de noble dédain",
        "resume": "Le chevalier hait tous les ennemis équipés d'armes de tir.",
        "resumeEn": "The knight hates every enemy armed with a missile weapon.",
        "condition": null
      },
      {
        "en": "Virtue of Impetuous",
        "nom": "Vertu d'impétuosité",
        "resume": "Quand il charge, le chevalier ajoute 1D3 ps à son mouvement (jet effectué avant de déplacer la figurine).",
        "resumeEn": "When charging the knight adds D3\" to his move, rolled before moving.",
        "condition": null
      }
    ]
  },
  "races": {},
  "notes": "Source Town Cryer 8 (non officielle). Taille 3 à 12 figurines. Les noms anglais des deux règles de bande ont été donnés par moi (la page ne les nomme pas) ; la page n'indique pas clairement si le 4+ pour tirer sur les chevaliers dépend du test de Commandement d'avant-partie. Restrictions : nombre d'Écuyers jamais supérieur au nombre de chevaliers ; un Chevalier errant ne peut monter un cheval de guerre que si le Chevalier de la quête en a un ; un Écuyer ne peut monter un cheval que si le Chevalier de la quête et tous les Chevaliers errants ont un cheval de guerre. Le texte des Vertus dit que seul le Chevalier de la quête peut les choisir, mais le tableau de compétences donne « Spéciales » au Chevalier errant aussi : j'ai donné la liste aux deux (condition null). La case « Spéciales » des Écuyers porte une icône d'édition sur la page (non cochée) : non accordée. Hommes d'armes 0-8 ; Archers sans limite. Prix Hache 5 / Épée 10 / Barde 30 (liste Chevaliers) marqués d'une icône d'édition : à vérifier. Barde bretonnienne : Rare 11, chevaux de guerre seulement, +1 à la sauvegarde. Cheval de guerre et Cheval : profils non donnés sur la page. Aucune arme de tir pour Chevaliers et Hommes d'armes."
}