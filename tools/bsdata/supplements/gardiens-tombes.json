  "reglesTexte": {
    "Do Not Drink": {
      "fr": {
        "nom": "Ni boire ni manger",
        "resume": "Les morts-vivants n'ont besoin ni d'eau ni de nourriture ; seuls les animaux vivants qui les accompagnent suivent les règles normales sur l'eau."
      },
      "en": {
        "nom": "Do Not Drink",
        "resume": "The undead need neither food nor water; only living animals in the warband follow the normal water rules."
      }
    },
    "Home Ground": {
      "fr": {
        "nom": "Terrain familier",
        "resume": "La bande lance un dé supplémentaire lors de la phase d'exploration (règle pensée pour le désert ; son usage ailleurs est flou)."
      },
      "en": {
        "nom": "Home Ground",
        "resume": "The warband rolls one extra dice in the exploration phase (written for the desert setting; unclear elsewhere)."
      }
    },
    "Flammable": {
      "fr": {
        "nom": "Inflammable",
        "resume": "Les touches d'attaques enflammées infligent au Seigneur des tombes le double de blessures."
      },
      "en": {
        "nom": "Flammable",
        "resume": "Hits from fire-based attacks inflict double wounds on the Tomb Lord."
      }
    },
    "Wizard (Mortuary Cult)": {
      "fr": {
        "nom": "Sorcier (Culte mortuaire)",
        "resume": "Le prêtre liche est un sorcier qui utilise les parchemins du Culte mortuaire (ce n'est pas de la nécromancie). Il ne peut pas porter d'armure."
      },
      "en": {
        "nom": "Wizard (Mortuary Cult)",
        "resume": "The Liche Priest is a wizard using Mortuary Cult scrolls (not Necromancy). He may not wear armour."
      }
    },
    "Scorpion Sting": {
      "fr": {
        "nom": "Dard de scorpion",
        "resume": "Le dard du scorpion fonctionne comme une arme enduite de lotus noir. Créature vivante et animal, le scorpion ne gagne jamais d'expérience."
      },
      "en": {
        "nom": "Scorpion Sting",
        "resume": "The scorpion's sting works as if coated with Black Lotus. Being a living animal, it never gains experience."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Gardiens des tombes)",
    "listeEn": "Special Skills (Tomb Guardians)",
    "competences": [
      {
        "en": "Drive Chariot",
        "nom": "Conduite de char",
        "resume": "Indispensable pour charger avec le char squelette : sans elle, le conducteur ne peut pas charger.",
        "resumeEn": "Required to charge with the Skeleton Chariot; without it the charioteer cannot charge.",
        "condition": null
      }
    ]
  },
  "races": {},
  "notes": "Aucun tableau de maximums sur la page : race null pour le Seigneur des tombes (E5 dépasse le maximum humain), les squelettes et les scorpions ; 'humain' supposé pour le prêtre liche et l'acolyte. Les flèches d'aspic et le javelot néhékharéen sont réservés au Seigneur des tombes ; le bâton serpent au prêtre liche (parade ; peut renoncer à ses attaques pour une attaque unique CC4 F4 frappant en premier). Flèches d'aspic et javelots : +1 pour toucher, pas de règle d'arme de jet. Char squelette (0-1) : 200 + 10D6 co, tiré par deux destriers squelettes (M8 CC2 CT2 F3 E3 PV1 I2 A1 Cd5), char F4 E4 PV3 — non saisi comme guerrier. Conduite de char est classée en Érudition sur la page ; présentée ici comme liste spéciale accessible aux héros ayant Érudition (le Seigneur des tombes n'y a pas accès). Gardes des tombes : la page indique que la source d'origine leur fait gagner de l'expérience (avec les maximums du Seigneur des tombes) — saisis sans 'No Brain' et avec progression ; à confirmer. Scorpions : la F est marquée 2* sur la page (astérisque lié au dard), saisie '2' ; CT '-'. Le prêtre liche ne peut pas porter d'armure (sa liste n'en contient pas)."
}