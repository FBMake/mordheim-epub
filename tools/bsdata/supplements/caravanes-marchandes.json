  "reglesTexte": {
    "Merchant": {
      "fr": {
        "nom": "Marchand",
        "resume": "Le marchand dirige la caravane. S'il disparaît, un nouveau chef est désigné et reprend cette règle ; à défaut, un apprenti doit être recruté dès que possible."
      },
      "en": {
        "nom": "Merchant",
        "resume": "The Merchant leads the caravan. If he is lost a new leader takes over this rule; failing that, an Apprentice must be hired as soon as possible."
      }
    },
    "Trade": {
      "fr": {
        "nom": "Commerce",
        "resume": "Avant la recherche d'objets rares, le marchand peut vendre un objet rare stocké dans le chariot : sur 1D6, 1-2 moitié du prix de base, 3-4 prix de base, 5-6 une fois et demie le prix de base. Il peut aussi le garder pour réessayer plus tard."
      },
      "en": {
        "nom": "Trade",
        "resume": "Before searching for rare items the Merchant may sell one rare item stored in the wagon: on a D6, 1-2 half base price, 3-4 base price, 5-6 one and a half times the base price. He may keep it to try again later."
      }
    },
    "Open for Business": {
      "fr": {
        "nom": "Boutique ouverte",
        "resume": "Un héros peut rendre visite au marchand au lieu de chercher des objets rares pour acheter un objet stocké ou vendre un objet à un prix convenu entre les joueurs."
      },
      "en": {
        "nom": "Open for Business",
        "resume": "Instead of searching for rare items a Hero may visit the Merchant to buy a stored item or sell one at a price agreed between players."
      }
    },
    "Rarity": {
      "fr": {
        "nom": "Rareté réduite",
        "resume": "Un objet rare dont la rareté tombe à 2 ou moins (réputation du chariot, Débrouillardise…) s'achète comme un objet courant."
      },
      "en": {
        "nom": "Rarity",
        "resume": "A rare item whose rarity drops to 2 or less (wagon reputation, Streetwise…) can be bought as a common item."
      }
    },
    "Lightning Reflexes": {
      "fr": {
        "nom": "Réflexes foudroyants",
        "resume": "Quand il est chargé, le chevalier frappe en premier contre les chargeurs ; si ceux-ci frappent aussi en premier, l'Initiative départage."
      },
      "en": {
        "nom": "Lightning Reflexes",
        "resume": "When charged the knight strikes first against the chargers; if they also strike first, Initiative decides."
      }
    },
    "Ride Warhorse": {
      "fr": {
        "nom": "Cavalier",
        "resume": "Le chevalier est entraîné à monter un cheval de guerre."
      },
      "en": {
        "nom": "Ride Warhorse",
        "resume": "The knight is trained to ride a warhorse."
      }
    },
    "Hirelings": {
      "fr": {
        "nom": "Mercenaires engagés",
        "resume": "Payé par le marchand, ce héros ne peut jamais devenir chef de la bande."
      },
      "en": {
        "nom": "Hirelings",
        "resume": "Paid by the Merchant, this hero can never lead the warband."
      }
    },
    "Wizard (Lesser Magic)": {
      "fr": {
        "nom": "Sorcier (Magie mineure)",
        "resume": "Le magicien est un sorcier qui utilise la magie mineure."
      },
      "en": {
        "nom": "Wizard (Lesser Magic)",
        "resume": "The Magician is a wizard using Lesser Magic."
      }
    },
    "Strongman": {
      "fr": {
        "nom": "Costaud",
        "resume": "Peut utiliser une arme lourde sans frapper systématiquement en dernier : l'ordre des attaques se règle comme pour les autres armes."
      },
      "en": {
        "nom": "Strongman",
        "resume": "May use a double-handed weapon without always striking last; strike order is worked out as for other weapons."
      }
    },
    "Unreliable Hirelings": {
      "fr": {
        "nom": "Mercenaires peu fiables",
        "resume": "Ces guerriers ne peuvent jamais devenir héros : relancez le résultat « Ce gars a du talent »."
      },
      "en": {
        "nom": "Unreliable Hirelings",
        "resume": "These warriors can never become Heroes: re-roll 'The lad's got talent' results."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Caravane marchande)",
    "listeEn": "Special Skills (Merchant)",
    "competences": [
      {
        "en": "Bribery",
        "nom": "Pots-de-vin",
        "resume": "Lors d'un test de déroute, payer 5 co par membre non-héros encore en jeu permet d'ignorer un membre hors de combat pour ce test ; répétable tant qu'il reste de l'or.",
        "resumeEn": "When a Rout test is due, paying 5 gc per non-Hero still in play lets one out-of-action member be ignored for it; repeatable while gold lasts.",
        "condition": "chef"
      },
      {
        "en": "Dubious Income",
        "nom": "Revenus douteux",
        "resume": "Après une bataille où il n'a pas été mis hors de combat, test de Cd : réussi, gagne 1 co par point d'XP du marchand ; raté, perd jusqu'à ce montant.",
        "resumeEn": "After a battle he was not taken out of action in, take a Ld test: success gains 1 gc per Merchant XP, failure loses up to that much.",
        "condition": "chef"
      },
      {
        "en": "Wholesale",
        "nom": "Vente en gros",
        "resume": "Après chaque bataille (s'il n'a pas été mis hors de combat), cherche 1D3+1 objets rares au lieu d'un.",
        "resumeEn": "After each battle (if not taken out of action) he searches for D3+1 rare items instead of one.",
        "condition": "chef"
      },
      {
