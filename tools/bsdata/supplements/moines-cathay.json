    "condition": "moines-cathay/dragon-monk"
   },
   {
    "en": "Warmonger",
    "nom": "Fauteur de guerre",
    "resume": "Avant la bataille, sur un test de Commandement réussi, recrute 1D3+1 paysans enragés pour la partie ; ils peuvent dépasser l'effectif maximum et ont la haine.",
    "resumeEn": "Before battle, on a passed Leadership test, recruits D3+1 Raging Peasants for the game; they may exceed the warband maximum and are subject to Hatred.",
    "condition": "chef"
   }
