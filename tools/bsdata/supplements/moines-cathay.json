 "reglesTexte": {
  "Strictures (Cathay)": {
   "fr": {
    "nom": "Préceptes monastiques",
    "resume": "Les moines dragons et les moines guerriers ne portent jamais d'armure."
   },
   "en": {
    "nom": "Strictures",
    "resume": "Dragon Monks and Warrior Monks never wear armour."
   }
  },
  "Outsiders": {
   "fr": {
    "nom": "Étrangers",
    "resume": "La bande ne peut engager ni franc-tireur ni personnage spécial, sauf si leur description l'autorise expressément."
   },
   "en": {
    "nom": "Outsiders",
    "resume": "The warband cannot hire Hired Swords or Dramatis Personae unless their entry explicitly allows it."
   }
  },
  "Ride Horse": {
   "fr": {
    "nom": "Cavalier (cheval)",
    "resume": "L'émissaire sait monter à cheval."
   },
   "en": {
    "nom": "Ride Horse",
    "resume": "The Emissary is trained to ride horses."
   }
  },
  "Decree": {
   "fr": {
    "nom": "Décret",
    "resume": "Si l'émissaire meurt, la bande doit en recruter un nouveau dès que possible et ne peut acheter ni guerrier ni équipement avant de l'avoir fait."
   },
   "en": {
    "nom": "Decree",
    "resume": "If the Emissary dies, a new one must be hired as soon as possible; no other warriors or equipment may be bought until then."
   }
  },
  "Martial Artist": {
   "fr": {
    "nom": "Arts martiaux",
    "resume": "Combat à mains nues sans pénalité et gagne +1 Attaque lorsqu'il est désarmé."
   },
   "en": {
    "nom": "Martial Artist",
    "resume": "Fights unarmed without penalty and gains +1 Attack when unarmed."
   }
  },
  "Art of Silent Death": {
   "fr": {
    "nom": "Art de la mort silencieuse",
    "resume": "À mains nues, ses attaques infligent un coup critique sur 5-6 pour blesser ; avec un bâton de combat, seules ses attaques à mains nues gardent ce bonus."
   },
   "en": {
    "nom": "Art of Silent Death",
    "resume": "When unarmed, his attacks cause a critical hit on a to-wound roll of 5-6; with a quarter staff only his unarmed attacks keep this bonus."
   }
  },
  "Bare-handed Brawlers": {
   "fr": {
    "nom": "Bagarreurs",
    "resume": "Les paysans combattent à mains nues sans subir de pénalité."
   },
   "en": {
    "nom": "Bare-handed Brawlers",
    "resume": "Peasants fight unarmed without any penalty."
   }
  },
  "Simple Folk": {
   "fr": {
    "nom": "Petites gens",
    "resume": "Le paysan ne gagne jamais d'expérience."
   },
   "en": {
    "nom": "Simple Folk",
    "resume": "The peasant never gains experience."
   }
  },
  "Mob": {
   "fr": {
    "nom": "Foule",
    "resume": "+1 en Commandement pour chaque autre paysan ami à 3 ps ou moins."
   },
   "en": {
    "nom": "Mob",
    "resume": "+1 Leadership for each other friendly Peasant within 3\"."
   }
  },
  "Ignored": {
   "fr": {
    "nom": "Ignorés",
    "resume": "Les paysans hors de combat ne comptent pas pour les tests de déroute."
   },
   "en": {
    "nom": "Ignored",
    "resume": "Peasants taken out of action do not count towards Rout tests."
   }
  },
  "Downtrodden": {
   "fr": {
    "nom": "Opprimés",
    "resume": "Un paysan blessé est mis hors de combat sans jet de blessure."
   },
   "en": {
    "nom": "Downtrodden",
    "resume": "A wounded Peasant goes out of action without rolling for injury."
   }
  }
 },
 "competencesSpeciales": {
  "liste": "Spéciales (Moines guerriers de Cathay)",
  "listeEn": "Special Skills (Battle Monks of Cathay)",
  "competences": [
