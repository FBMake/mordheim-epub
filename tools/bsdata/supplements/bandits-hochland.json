  "reglesTexte": {
    "Hired Swords": {
      "fr": {
        "nom": "Francs-tireurs",
        "resume": "La bande peut recruter tous les francs-tireurs accessibles à une bande de mercenaires humains."
      },
      "en": {
        "nom": "Hired Swords",
        "resume": "The warband may hire any Hired Sword available to a Human Mercenary warband."
      }
    },
    "Powder's Expensive!": {
      "fr": {
        "nom": "La poudre, ça coûte cher !",
        "resume": "Trop pauvres pour entretenir des armes à poudre, les bandits les paient plus cher ; seuls les héros peuvent en acheter, jamais les hommes de main."
      },
      "en": {
        "nom": "Powder's Expensive!",
        "resume": "Too poor to upkeep black powder weapons, bandits pay more for them; only heroes may buy them, never henchmen."
      }
    },
    "Foragers": {
      "fr": {
        "nom": "Fourrageurs",
        "resume": "Pour le revenu, la bande utilise la colonne de taille immédiatement inférieure (les bandes de 1 à 3 restent dans la première colonne)."
      },
      "en": {
        "nom": "Foragers",
        "resume": "For income, the warband uses the next smaller size column (warbands of 1-3 stay in the first column)."
      }
    },
    "Know Who To Sell To": {
      "fr": {
        "nom": "Savoir à qui vendre",
        "resume": "En revendant de l'équipement, la bande touche la moitié du prix de base plus la moitié de la part aléatoire du prix."
      },
      "en": {
        "nom": "Know Who To Sell To",
        "resume": "When selling equipment, the warband gets half the base price plus half of any random part of the price."
      }
    },
    "Concealment": {
      "fr": {
        "nom": "Discrétion",
        "resume": "Un ennemi qui ne le voit pas (sans qu'il soit déclaré caché) retire 1 à son Initiative avant le test pour le charger ; un 6 fait toujours échouer cette charge."
      },
      "en": {
        "nom": "Concealment",
        "resume": "An enemy that cannot see him (without him being declared Hidden) takes -1 Initiative before testing to charge him; a 6 always fails that charge."
      }
    },
    "Swordmaster": {
      "fr": {
        "nom": "Maître d'armes",
        "resume": "Ses parades réussissent sur un résultat égal ou supérieur au jet pour toucher adverse ; il doit être armé pour parer."
      },
      "en": {
        "nom": "Swordmaster",
        "resume": "His parries succeed on a roll equal to or higher than the enemy's to-hit roll; he must be armed to parry."
      }
    },
    "Weapon Knowledge": {
      "fr": {
        "nom": "Connaissance des armes",
        "resume": "Il peut utiliser n'importe quelle arme de corps à corps ou de tir accessible à la bande."
      },
      "en": {
        "nom": "Weapon Knowledge",
        "resume": "He may use any close-combat or missile weapon available to the warband."
      }
    },
    "Convincing Manner": {
      "fr": {
        "nom": "Bagout",
        "resume": "Un ennemi qui charge un membre de la bande à 12 ps ou moins du bonimenteur doit réussir un test de Cd, sinon la charge échoue ; les créatures stupides et les animaux n'y sont pas sensibles."
      },
      "en": {
        "nom": "Convincing Manner",
        "resume": "An enemy charging a warband member within 12\" of him must pass a Ld test or fail the charge; stupid models and animals are immune."
      }
    },
    "Slick Operator": {
      "fr": {
        "nom": "Escroc habile",
        "resume": "Entre deux parties, sur 2-6 au D6 la bande gagne 2D6 co ; sur 1, le bonimenteur manque la partie suivante et ne rapporte rien."
      },
      "en": {
        "nom": "Slick Operator",
        "resume": "Between games, on a D6 roll of 2-6 the warband gains 2D6 gc; on a 1 he misses the next game and earns nothing."
      }
    },
    "Looting the Dead": {
      "fr": {
        "nom": "Dépouiller les morts",
        "resume": "Après la bataille, pour chaque guerrier rayé de la feuille, un 4+ au D6 permet au pillard de récupérer son équipement (une fois par guerrier)."
      },
      "en": {
        "nom": "Looting the Dead",
        "resume": "After a battle, for each warrior removed from the roster, a D6 roll of 4+ lets the Looter take his equipment (once per warrior)."
      }
    },
    "Hardened": {
      "fr": {
        "nom": "Endurcis",
        "resume": "Ils sont insensibles à la peur et aux tests « Seul contre tous »."
      },
      "en": {
        "nom": "Hardened",
        "resume": "They are immune to fear and All Alone tests."
      }
    },
    "Trailblazers": {
      "fr": {
        "nom": "Éclaireurs",
        "resume": "Pendant l'exploration, la bande peut relancer un dé par braconnier."
      },
      "en": {
        "nom": "Trailblazers",
        "resume": "During exploration, the warband may re-roll one die per Poacher."
      }
    },
    "Utterly Inept": {
      "fr": {
        "nom": "Totalement incapables",
        "resume": "La racaille ne gagne jamais d'expérience."
      },
      "en": {
        "nom": "Utterly Inept",
        "resume": "Gutterscum never gain experience."
      }
    }
  },
  "competencesSpeciales": {
    "liste": "Spéciales (Bandits du Hochland)",
    "listeEn": "Special Skills (Hochland Bandits)",
    "competences": [
      {
        "en": "Banditry",
        "nom": "Brigandage",
        "resume": "Entre deux parties, sur 2-6 au D6 il rapporte D6+1 co ; sur 1, il jette sur la table des blessures graves. Incompatible avec « Escroc habile ».",
        "resumeEn": "Between games, on a D6 roll of 2-6 he brings in D6+1 gc; on a 1 he rolls on the Serious Injury table. Cannot be combined with Slick Operator.",
        "condition": null
      },
      {
        "en": "Hide in Shadows",
        "nom": "Se fondre dans l'ombre",
        "resume": "Un ennemi qui tente de le repérer alors qu'il est caché divise son Initiative par deux avant de mesurer.",
        "resumeEn": "An enemy trying to detect him while he is Hidden halves its Initiative before measuring.",
        "condition": null
      },
      {
