  "reglesTexte": {
    "Undead Leader": {
      "fr": {
        "nom": "Chef mort-vivant",
        "resume": "Le vampire strigoï est le seul mort-vivant de la bande. S'il meurt, la bande continue mais ne peut pas recruter de nouveau vampire."
      },
      "en": {
        "nom": "Undead Leader",
        "resume": "The Strigoi is the warband's only Undead model. If he dies the warband carries on but can never hire a new vampire."
      }
    },
    "Kindred Hatred (Vampires)": {
      "fr": {
        "nom": "Haine des lignées",
        "resume": "Le strigoï hait les vampires des autres lignées."
      },
      "en": {
        "nom": "Kindred Hatred",
        "resume": "The Strigoi hates vampires of other bloodlines."
      }
    },
    "Seeker": {
      "fr": {
        "nom": "Traqueur",
        "resume": "Si le guerrier n'est pas mis hors de combat, il peut modifier de +1 ou -1 un dé d'exploration après la bataille."
      },
      "en": {
        "nom": "Seeker",
        "resume": "If the model was not taken out of action, it may modify one exploration dice by +1 or -1 after the battle."
      }
    },
    "Wizard (Charms & Hexes)": {
      "fr": {
        "nom": "Sorcier (Charmes et maléfices)",
        "resume": "La voyante est un lanceur de sorts : elle commence avec un sort tiré au hasard dans la liste des Charmes et maléfices."
      },
      "en": {
        "nom": "Wizard (Charms & Hexes)",
        "resume": "The Seer is a spellcaster and starts with one random spell from the Charms & Hexes list."
      }
    },
    "Child of Darkness": {
      "fr": {
        "nom": "Enfant des ténèbres",
        "resume": "Le domnu n'est pas affecté par la règle « Sinistre » (Spooky) de la Sylvanie."
      },
      "en": {
        "nom": "Child of Darkness",
        "resume": "The Domnu is unaffected by Sylvania's Spooky rule."
      }
    },
    "Gypsy Ward": {
      "fr": {
        "nom": "Protection tzigane",
        "resume": "Le guerrier bénéficie d'une sauvegarde spéciale de 5+ contre les attaques magiques."
      },
      "en": {
        "nom": "Gypsy Ward",
        "resume": "The model has a 5+ special save against magical attacks."
      }
    },
    "Flying": {
      "fr": {
        "nom": "Vol",
        "resume": "La créature ignore les règles d'escalade et de saut au-dessus des vides, et peut même terminer son mouvement au-dessus du vide."
      },
      "en": {
        "nom": "Flying",
        "resume": "Ignores climbing and jumping across gaps, and may even end its move over empty space."
      }
    },
    "Sonic": {
      "fr": {
        "nom": "Écholocation",
        "resume": "La créature n'a pas besoin de ligne de vue pour charger."
      },
      "en": {
        "nom": "Sonic",
        "resume": "The creature does not need line of sight to charge."
      }
    }
  },
