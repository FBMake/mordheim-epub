 "reglesTexte": {
  "No Promotion": {
   "fr": {
    "nom": "Pas de promotion",
    "resume": "Les zombies et les créatures de chair ne peuvent jamais devenir des héros grâce au résultat « Le petit a du talent »."
   },
   "en": {
    "nom": "No Promotion",
    "resume": "Zombies and Flesh Constructs can never become Heroes through the Lad's Got Talent result."
   }
  },
  "Tooth and Claw": {
   "fr": {
    "nom": "Crocs et griffes",
    "resume": "Ne peut porter aucun équipement ; il combat avec ses crocs et ses griffes sans pénalité de combat à mains nues."
   },
   "en": {
    "nom": "Tooth and Claw",
    "resume": "Cannot carry any equipment; fights with teeth and claws without the unarmed penalty."
   }
  },
  "A Bit Unhinged": {
   "fr": {
    "nom": "Un peu dérangé",
    "resume": "Après la partie, il doit réussir un test de Commandement pour gagner l'expérience de survie."
   },
   "en": {
    "nom": "A Bit Unhinged",
    "resume": "After the battle it must pass a Leadership test to gain the survival experience."
   }
  },
  "Only a Flesh Wound": {
   "fr": {
    "nom": "Juste une égratignure",
    "resume": "Sur un 1-2 au jet de blessure après une mise hors de combat, la bande peut le réparer pour D6×5 co ; faute de payer, il manque la bataille suivante et reste sur la feuille jusqu'à réparation ou abandon."
   },
   "en": {
    "nom": "Only a Flesh Wound",
    "resume": "On an Injury roll of 1-2 after going out of action it can be repaired for D6x5 gc; if unpaid it misses the next battle and stays on the roster until repaired or abandoned."
   }
  },
  "Transform": {
   "fr": {
    "nom": "Transformation",
    "resume": "À chaque tour, D6 : sur 1 il est stupide (et reprend forme humaine s'il était transformé), sur 6 il se transforme et gagne Frénésie et Sprint jusqu'au prochain 1 ; transformé, il lâche son équipement sauf une dague et combat à mains nues sans pénalité."
   },
   "en": {
    "nom": "Transform",
    "resume": "Each turn roll a D6: on a 1 it is Stupid (and reverts if transformed), on a 6 it transforms, gaining Frenzy and Sprint until a 1 is rolled; transformed, it drops its gear except a dagger and fights unarmed without penalty."
   }
  }
 },
