  "reglesTexte": {
    "Sacrifice": {
      "fr": {
        "nom": "Sacrifice",
        "resume": "Les Amazones sacrifient leurs captifs à leurs dieux et suivent pour eux les règles des captifs du Culte des Possédés."
      },
      "en": {
        "nom": "Sacrifice",
        "resume": "Amazons sacrifice captives to their gods, using the Cult of the Possessed rules for captives."
      }
    },
    "Not one of us": {
      "fr": {
        "nom": "Pas des nôtres",
        "resume": "Les Amazones ne s'allient à personne : elles ne recrutent ni franc-tireur ni personnage spécial qui ne soit pas une Amazone."
      },
      "en": {
        "nom": "Not one of us",
        "resume": "Amazons side with no one: they may only hire Hired Swords or Dramatis Personae who are Amazons."
      }
    },
    "Wizard (Amazon Rituals)": {
      "fr": {
        "nom": "Sorcier (Rituels amazones)",
        "resume": "La prêtresse lance des Rituels amazones et commence avec un rituel tiré au hasard."
      },
      "en": {
        "nom": "Wizard (Amazon Rituals)",
        "resume": "The Priestess casts Amazon Rituals and starts with one random ritual."
      }
    },
    "Stealthy": {
      "fr": {
        "nom": "Furtives",
        "resume": "Les éclaireuses peuvent se déployer à deux fois la distance normale et commencer la bataille cachées."
      },
      "en": {
        "nom": "Stealthy",
        "resume": "Scouts may deploy twice as far onto the battlefield as other warriors and may start the battle Hidden."
      }
    }
  },
  "competencesSpeciales": null,
  "races": {},
  "notes": "Version Mordheim (Town Cryer #23), pas Lustria. Pas de liste de compétences spéciales. Maximums de caractéristiques : ceux des humains. Championnes et guerrières totem : « listes des héroïnes et d'équipement spécial » ; l'équipement spécial désigne l'accès au comptoir, seule la liste des héroïnes est saisie. Guerrières amazones : au moins un groupe obligatoire (min 1). Sorts (Rituels amazones) non saisis. Aucune restriction d'armure n'est indiquée pour la prêtresse."
}