 "reglesTexte": {
  "Foolish Nobleness": {
   "fr": {
    "nom": "Noblesse insensée",
    "resume": "La bande compte comme maléfique (traitée comme le Culte des Possédés, par ex. pour l'exploration) et n'engage ni franc-tireur ni personnage spécial, sauf le maître des corbeaux."
   },
   "en": {
    "nom": "Foolish Nobleness",
    "resume": "The warband counts as Evil (treated like the Cult of the Possessed, e.g. for exploration) and hires no Hired Swords or Dramatis Personae except the Crow Master."
   }
  },
  "Capture!": {
   "fr": {
    "nom": "Capture !",
    "resume": "Quand un héros met hors de combat un homme de main humain avec une miséricorde, sur 5+ il est capturé (5 serviteurs capturés au plus, 2 captures par partie)."
   },
   "en": {
    "nom": "Capture!",
    "resume": "When a Hero takes a human Henchman out of action with a Misericordia, on a 5+ it is captured (max 5 Captured Thralls, 2 captures per game)."
   }
  },
  "The Throne of Worms": {
   "fr": {
    "nom": "Le Trône des vers",
    "resume": "Après la bataille, chaque captif est perdu (1-2), devient un serviteur capturé (3-5) ou est sacrifié et un héros au hasard gagne 1 XP (6)."
   },
   "en": {
    "nom": "The Throne of Worms",
    "resume": "After battle each captive is lost (1-2), becomes a Captured Thrall (3-5) or is sacrificed and a random Hero gains 1 XP (6)."
   }
  },
  "Expert Horseman": {
   "fr": {
    "nom": "Cavalier expert",
    "resume": "L'aristocrate sait monter un cauchemar (compétence Monter (cauchemar))."
   },
   "en": {
    "nom": "Expert Horseman",
    "resume": "The Aristocrat has the Ride (Nightmare) skill."
   }
  },
  "Expert Swordsman": {
   "fr": {
    "nom": "Épéiste expert",
    "resume": "Le compagnon commence avec la compétence Épéiste expert."
   },
   "en": {
    "nom": "Expert Swordsman",
    "resume": "The Companion starts with the Expert Swordsman skill."
   }
  },
  "Magical Adept": {
   "fr": {
    "nom": "Adepte magique",
    "resume": "Option à +10 co : l'érudit devient sorcier de Magie mineure avec un sort au hasard (exclusif avec Conteur)."
   },
   "en": {
    "nom": "Magical Adept",
    "resume": "+10 gc option: the Scholar becomes a Lesser Magic wizard with one random spell (exclusive with Story Teller)."
   }
  },
  "Story Teller": {
   "fr": {
    "nom": "Conteur",
    "resume": "Option à +10 co : l'érudit devient chroniqueur et relance un dé d'exploration en gardant le résultat voulu (exclusif avec Adepte magique)."
   },
   "en": {
    "nom": "Story Teller",
    "resume": "+10 gc option: the Scholar becomes a Chronicler and re-rolls one exploration die, keeping the one he wants (exclusive with Magical Adept)."
   }
  },
  "Danse Macabre": {
   "fr": {
    "nom": "Danse macabre",
    "resume": "En phase de tir, un ennemi visible à 6 ps rate un test de Commandement et le joueur de flûte contrôle ses déplacements jusqu'à ce qu'il réussisse un test en phase de ralliement ; il ne peut ni tirer, ni charger, ni lancer de sort."
   },
   "en": {
    "nom": "Danse Macabre",
    "resume": "In the shooting phase, a visible enemy within 6\" that fails a Leadership test has its movement controlled by the Piper until it passes a test in its Recovery phase; it cannot shoot, charge or cast."
   }
  },
  "Piper's Instrument": {
   "fr": {
    "nom": "Instrument",
    "resume": "Tient son instrument d'une main : ni arme dans l'autre main, ni arme lourde, ni paire de pistolets, ni arc, ni arbalète."
   },
   "en": {
    "nom": "Piper's Instrument",
    "resume": "Holds his instrument in one hand: no off-hand weapon, double-handed weapon, brace of pistols, bow or crossbow."
   }
  },
  "Maddened With Pain": {
   "fr": {
    "nom": "Fou de douleur",
    "resume": "Gagne une Attaque supplémentaire après avoir subi sa première blessure."
   },
   "en": {
    "nom": "Maddened With Pain",
    "resume": "Gains an extra Attack after suffering its first wound."
   }
  },
  "Cymbals": {
   "fr": {
    "nom": "Cymbales",
    "resume": "Option à +15 co : les ennemis à 6 ps ou moins subissent -1 en CT et en Cd."
   },
   "en": {
    "nom": "Cymbals",
    "resume": "+15 gc option: enemies within 6\" suffer -1 BS and -1 Ld."
   }
  },
  "Agile": {
   "fr": {
    "nom": "Agile",
    "resume": "Possède Escalade, Acrobate et Esquive, peut charger en plongeant d'une hauteur de 10 ps et entrer dans les bâtiments."
   },
   "en": {
    "nom": "Agile",
    "resume": "Has Scale Sheer Surfaces, Acrobat and Dodge, may make a diving charge from up to 10\" high and may enter buildings."
   }
  }
 },
 "competencesSpeciales": {
  "liste": "Spéciales (Cavalcade maudite)",
