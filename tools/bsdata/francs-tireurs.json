  "reglesTexte": {
    "Hired Sword": {
      "fr": {"nom": "Franc-tireur", "resume": "Mercenaire engagé contre une prime puis une solde après chaque partie (sinon il part). Il ne compte pas dans l'effectif maximum ni parmi les héros, garde son équipement sans en acheter d'autre, un seul de chaque type par bande ; blessures comme un homme de main, progressions sur le tableau des héros."},
      "en": {"nom": "Hired Sword", "resume": "Mercenary paid a hire fee, then an upkeep after every battle (or he leaves). He does not count towards the warband's maximum size or heroes, keeps his own equipment and cannot buy more, one of each type per warband; injuries as a henchman, advances on the heroes table."}
    },
    "Spiked Gauntlet": {
      "fr": {"nom": "Gantelet à pointes", "resume": "Compte à la fois comme une rondache et comme une arme additionnelle. Vos héros ne peuvent pas apprendre à s'en servir."},
      "en": {"nom": "Spiked Gauntlet", "resume": "Counts both as a buckler and as an additional hand weapon. Your heroes cannot learn to use it."}
    },
    "Cook": {
      "fr": {"nom": "Cuistot", "resume": "Une bande avec un halfling peut compter une figurine de plus que sa taille maximale (pas un héros de plus)."},
      "en": {"nom": "Cook", "resume": "A warband with a Halfling may exceed its maximum size by one model (not one more hero)."}
    },
    "Seeker": {
      "fr": {"nom": "Chercheur", "resume": "Sur le tableau d'exploration, permet de modifier le résultat d'un dé de -1 ou +1."},
      "en": {"nom": "Seeker", "resume": "When rolling on the Exploration chart, may modify one dice result by -1 or +1."}
    },
    "Excellent Sight": {
      "fr": {"nom": "Vue perçante", "resume": "Les elfes repèrent les ennemis cachés à une distance égale au double de leur Initiative en pas."},
      "en": {"nom": "Excellent Sight", "resume": "Elves spot hidden enemies at twice their Initiative in inches."}
    },
    "Wizard (Lesser Magic)": {
      "fr": {"nom": "Sorcier (Magie mineure)", "resume": "Lance des sorts de magie mineure."},
      "en": {"nom": "Wizard (Lesser Magic)", "resume": "Casts spells from Lesser Magic."}
    }
  },
